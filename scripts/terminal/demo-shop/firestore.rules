rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && request.auth.token.get('staff', false) == true;
    }

    // Anyone can browse the catalogue; only staff change it.
    match /products/{sku} {
      allow read: if true;
      allow write: if isStaff()
        && request.resource.data.price is number
        && request.resource.data.price > 0;
    }

    // Orders come from the checkout function; staff read them.
    match /orders/{orderId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Each customer keeps their own profile.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone']);
    }
  }
}

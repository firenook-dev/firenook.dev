---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import CopyCommand from '../components/CopyCommand.astro';
import BenchPairs from '../components/BenchPairs.astro';
import ConsoleTabs from '../components/ConsoleTabs.astro';
import Services from '../components/Services.astro';
import KeepData from '../components/KeepData.astro';
import AgentSession from '../components/AgentSession.astro';
import Pixels from '../components/Pixels.astro';
import Embers from '../components/Embers.astro';
import { site, notEmulated } from '../lib/site';
import { benchmark, pairs } from '../lib/benchmarks';
import { homeFaqs } from '../lib/faqs';
import { graph, organization, website, application, faqPage } from '../lib/schema';
import mcpTools from '../data/mcp-tools.json';

const pair = (label: string) => {
  const found = pairs.find((entry) => entry.label === label);
  if (!found) throw new Error(`no benchmark row "${label}"`);
  return found;
};
const write = pair('Write, median');
const memory = pair('Memory at peak');
const restart = pair('Restart with data kept');
const stats = [
  { lead: write.claim.split(' ')[0], text: 'faster writes', detail: `${write.firenook} ${write.unit} against ${write.official} ${write.unit}, median` },
  { lead: memory.claim.split(' ')[0], text: 'less memory', detail: `${memory.firenook} ${memory.unit} against ${memory.official} ${memory.unit} at peak` },
  { lead: `${restart.firenook} s`, text: 'to restart with your data', detail: `against ${restart.official} ${restart.unit} on the official emulator` },
];

const kept = [
  { title: 'firebase.json and .firebaserc', text: 'Read the way the Firebase CLI reads them.' },
  { title: 'Rules, indexes, Functions', text: 'Your code and config stay as they are.' },
  { title: 'Your SDKs', text: 'connectFirestoreEmulator, FIRESTORE_EMULATOR_HOST and the rest connect unchanged.' },
  { title: 'Your data', text: 'Imports and exports the official format, both ways.' },
];

// What an agent can do, by the tools' own groups.
const toolGroups = [
  { name: 'Firestore', can: 'Read, query, count, write and delete documents' },
  { name: 'Authentication', can: 'Manage users, read sign-in codes, mint ID tokens, set claims' },
  { name: 'Storage', can: 'List, read, upload, copy, move and delete files' },
  { name: 'Functions', can: 'Invoke a function, read each call in full, replay it after a fix' },
  { name: 'Logs', can: 'Search every emulator’s and every function’s output' },
  { name: 'Security Rules', can: 'Ask why a request is denied, test a draft, list denials' },
  { name: 'Pub/Sub, Tasks, Eventarc', can: 'Publish, peek, run tasks and schedules now, replay events' },
];

const steps = [
  {
    title: 'Install it next to firebase-tools',
    text: 'Keep firebase-tools for deploying. --save-exact keeps you on this release until you upgrade on purpose.',
    command: site.install,
  },
  {
    title: 'Check your project',
    text: 'This reads firebase.json the way the Firebase CLI does, and changes nothing.',
    command: 'npx firenook init --adopt --dry-run',
  },
  {
    title: 'Swap the command',
    text: 'Same flags and ports, so your app connects as before and your data imports as it is.',
    command: 'npx firenook emulators:start',
  },
];

const schema = graph(organization, website, application, faqPage(homeFaqs));
---

<Base
  title="Firenook: a drop-in replacement for the Firebase Local Emulator Suite"
  description={site.description}
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <h1>A drop-in replacement for the Firebase Local Emulator&nbsp;Suite</h1>
      <div class="hero-row">
        <div class="hero-pitch">
          <p class="lede">
            Keep your <code>firebase.json</code>, SDKs and ports, and change one word in your script. No Java to install, and
            your data survives restarts.
          </p>
          <div class="actions">
            <CopyCommand command={site.install} />
            <a class="button button-primary" href="/docs/get-started/install">Get started</a>
          </div>
          <p class="hero-small">Free and open source under Apache 2.0. {site.requirements}.</p>
        </div>
        <dl class="hero-stats" aria-label="Measured against the official emulator on a real application">
          {
            stats.map((stat) => (
              <div>
                <dt class="lit">{stat.lead}</dt>
                <dd>
                  <span>{stat.text}</span>
                  <small>{stat.detail}</small>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
    <div class="wrap hero-terminal">
      <Terminal />
    </div>
  </section>

  <section class="section one-word" aria-labelledby="one-word">
    <div class="wrap">
      <div class="head">
        <h2 id="one-word">Change one word</h2>
        <p class="lede">
          Same flags, same ports, same export format. Your project stays as it is, and firebase-tools stays for deploying.
        </p>
      </div>
      <figure class="diff">
        <figcaption class="diff-file">package.json</figcaption>
        <pre aria-label="In your scripts, firebase becomes firenook"><span class="diff-line diff-old"><span class="diff-sign">-</span>  "emulators": "<mark>firebase</mark> emulators:start --import ./data"</span><span class="diff-line diff-new"><span class="diff-sign">+</span>  "emulators": "<mark>firenook</mark> emulators:start --import ./data"</span></pre>
      </figure>
      <ul class="kept">
        {
          kept.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="services">
    <div class="wrap">
      <div class="head">
        <h2 id="services">Eight emulators, on the ports you already use</h2>
        <p class="lede">
          Your SDKs connect to them as they connect to Google’s: the same hosts, the same ports, the same environment
          variables.
        </p>
      </div>
      <div class="services">
        <Services />
      </div>
      <p class="note">
        The orders, users, files and calls above are from a run of the demo project, as Firenook returned them.{' '}
        {notEmulated.slice(0, -1).join(', ')} and {notEmulated.at(-1)} are not emulated; a <code>firebase.json</code> that
        configures them still starts, with a warning. <a href="/compatibility">What each service covers</a>.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="measured">
    <div class="wrap">
      <div class="head">
        <h2 id="measured">Measured on a real application</h2>
        <p class="lede">
          Two hours of a production app’s traffic against each emulator in turn, on one server: 211,205 Firestore documents,
          6.7 GB in Storage, and every write, listener update and function call timed by the client.
        </p>
      </div>
      <div class="bench">
        <BenchPairs />
      </div>
      <p class="note">
        Lower is better on every measure. The official emulator answered {benchmark.queryShapesOfficialWins} of{' '}
        {benchmark.queryShapes} query shapes faster: ordering and range filters over a large collection, and batch gets of
        many documents. <a href="/benchmarks">How it was measured</a>, with every figure and its limits.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="data-stays">
    <div class="wrap split">
      <div class="head">
        <h2 id="data-stays">Your data stays where you left it</h2>
        <p class="lede">
          Add <code>--keep-data</code> and Firestore, Auth and Storage come back with all your data in about half a second,
          even with millions of documents. No export at every stop, no import at every start.
        </p>
        <p class="prose">
          A crash loses at most the last second of writes, where the official emulator loses everything since its last
          export. A stop always closes the data cleanly.
        </p>
        <div class="actions">
          <CopyCommand command="npx firenook emulators:start --keep-data" />
        </div>
      </div>
      <KeepData />
    </div>
  </section>

  <section class="section" aria-labelledby="console">
    <div class="wrap">
      <div class="head">
        <h2 id="console">The console the Firebase emulators should have had</h2>
        <p class="lede">
          Google’s Emulator UI has no page for your Functions, Pub/Sub, Cloud Tasks or Eventarc, only a log. Firenook’s
          console covers every service it runs, live, on the Emulator UI’s port.
        </p>
      </div>
      <div class="console">
        <ConsoleTabs />
      </div>
      <p class="note">
        Light and dark, works offline, sends nothing anywhere. Bookmarks to the official UI’s pages open the matching console
        page. <a href="/console">Every page of the console</a>.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="agents">
    <div class="wrap split split-agent">
      <div class="head">
        <h2 id="agents">Give your agent the emulator, not production</h2>
        <p class="lede">
          <code>firenook mcp</code> gives a coding agent {mcpTools.tools.length} tools over the running suite. It reads the
          log and each function call with its error, asks the Security Rules why a request is denied, and works with your
          data. Nothing leaves your machine.
        </p>
        <div class="actions">
          <CopyCommand command="npx firenook mcp add" />
        </div>
        <p class="prose">
          Sets it up for Claude Code, Cursor and VS Code in the project’s own files. Other agents run{' '}
          <code>npx firenook mcp</code>. <a href="/mcp">How agents use it</a>.
        </p>
      </div>
      <AgentSession />
    </div>
    <div class="wrap">
      <dl class="tools" aria-label={`What the ${mcpTools.tools.length} tools do`}>
        {
          toolGroups.map((group) => (
            <div>
              <dt>{group.name}</dt>
              <dd>{group.can}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="get-started">
    <div class="wrap">
      <div class="head">
        <h2 id="get-started">Switch in three steps</h2>
        <p class="lede">
          Starting a new project instead? <code>npx firenook init</code> sets one up, and{' '}
          <a href="/docs/get-started/install">the getting started guide</a> covers both.
        </p>
      </div>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li>
              <span class="step-number" aria-hidden="true">
                {index + 1}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              <CopyCommand command={step.command} wrap />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="questions">
    <div class="wrap faq">
      <h2 id="questions">Questions</h2>
      <div class="faq-list">
        {
          homeFaqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="closing" aria-labelledby="try">
    <div class="wrap closing-inner">
      <div class="closing-flame cells-glow">
        <Pixels art="flame" size={150} />
      </div>
      <h2 id="try">Try it on your project</h2>
      <p class="lede">One package, nothing else to install. Your emulators, without the wait.</p>
      <div class="actions">
        <CopyCommand command={site.install} />
        <a class="button button-primary" href="/docs/get-started/install">Get started</a>
      </div>
    </div>
    <Embers class="closing-embers" columns={110} rows={14} seed={23} />
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow-x: clip;
    padding-top: clamp(3rem, 7vw, 5.5rem);
  }

  .hero h1 {
    max-width: 15em;
    font-size: clamp(2.55rem, 5.9vw, 4.9rem);
    font-weight: 780;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .hero-row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .hero-pitch .lede {
    max-width: 30em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .actions :global(.copy-command) {
    max-width: 100%;
  }

  .hero-small {
    margin-top: 1rem;
    color: var(--ash);
    font-size: var(--step--1);
  }

  .hero-stats {
    display: grid;
    margin: 0;
    border-left: 1px solid var(--line);
  }

  .hero-stats div {
    display: grid;
    grid-template-columns: 6.6rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 0 0.8rem 1.6rem;
  }

  .hero-stats div:first-child {
    padding-top: 0.2rem;
  }

  .hero-stats div + div {
    border-top: 1px solid var(--line);
  }

  .hero-stats dt {
    font-size: 2.35rem;
    font-weight: 780;
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
  }

  .hero-stats dd {
    display: grid;
    gap: 0.1rem;
    margin: 0;
  }

  .hero-stats dd span {
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .hero-stats small {
    color: var(--ash);
    font-size: 0.84rem;
  }

  .hero-terminal {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: clamp(5.5rem, 9vw, 8rem);
  }

  .note {
    max-width: 52em;
    margin-top: 1.75rem;
    color: var(--ash);
    font-size: 0.95rem;
  }

  .note a {
    color: var(--link);
  }

  /* Change one word */
  .one-word {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .diff {
    margin: 2.75rem 0 0;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background: var(--cinder);
  }

  .diff-file {
    padding: 0.7rem 1.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--smoke);
    font: 560 0.85rem / 1.2 var(--mono);
  }

  .diff pre {
    margin: 0;
    overflow-x: auto;
    padding: 1rem 0;
    font-size: clamp(0.9rem, 1.65vw, 1.3rem);
    line-height: 1.85;
  }

  .diff-line {
    display: block;
    padding: 0 1.25rem;
  }

  .diff-sign {
    display: inline-block;
    width: 1.5ch;
  }

  .diff-old {
    background: rgb(255 106 95 / 0.08);
    color: #ffb1aa;
  }

  .diff-new {
    background: rgb(76 195 138 / 0.08);
    color: #a6ebc6;
  }

  .diff mark {
    padding: 0.05em 0.15em;
    border-radius: 4px;
    color: #fff;
  }

  .diff-old mark {
    background: rgb(255 106 95 / 0.42);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }

  .diff-new mark {
    background: rgb(76 195 138 / 0.42);
  }

  .kept {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .kept li {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line-strong);
  }

  .kept h3 {
    font-size: 1.02rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .kept p {
    color: var(--smoke);
    font-size: 0.95rem;
  }

  .services,
  .bench,
  .console {
    margin-top: clamp(2.5rem, 4vw, 3.25rem);
  }

  /* Words on the left, the artefact on the right. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }

  .split .head {
    align-content: start;
  }

  .split .actions {
    margin-top: 0.4rem;
  }

  .split-agent {
    align-items: start;
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin: clamp(3rem, 5vw, 4rem) 0 0;
    font-size: 0.95rem;
  }

  .tools div {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .tools dt {
    color: var(--ink);
    font-weight: 650;
  }

  .tools dd {
    margin: 0;
    color: var(--smoke);
  }

  /* Switch in three steps */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: clamp(2.5rem, 4vw, 3.25rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: linear-gradient(180deg, #1c1c20, #18181b);
  }

  .step-number {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: 0.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 7px;
    background: var(--hearth-2);
    color: var(--ink);
    font-weight: 700;
  }

  .steps p {
    color: var(--smoke);
    font-size: 0.97rem;
  }

  .steps :global(.copy-command) {
    align-self: start;
    max-width: 100%;
    margin-top: auto;
  }

  /* Questions */
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .faq-list details {
    border-bottom: 1px solid var(--line);
  }

  .faq-list details:first-child {
    border-top: 1px solid var(--line);
  }

  .faq-list summary {
    position: relative;
    padding: 1.2rem 2.5rem 1.2rem 0;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 620;
    cursor: pointer;
    list-style: none;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list summary::after {
    content: '';
    position: absolute;
    right: 0.25rem;
    top: 50%;
    width: 0.6rem;
    height: 0.6rem;
    border-right: 1.6px solid var(--smoke);
    border-bottom: 1.6px solid var(--smoke);
    transform: translateY(-70%) rotate(45deg);
    transition: transform 160ms ease;
  }

  .faq-list details[open] summary::after {
    transform: translateY(-30%) rotate(225deg);
  }

  .faq-list details p {
    max-width: 38em;
    padding-bottom: 1.35rem;
    color: var(--smoke);
  }

  /* The fire, once more, and the command. */
  .closing {
    position: relative;
    overflow: hidden;
    padding-top: clamp(5rem, 10vw, 8rem);
    padding-bottom: clamp(9rem, 16vw, 13rem);
    border-top: 1px solid var(--line);
    isolation: isolate;
  }

  .closing-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }

  .closing .actions {
    max-width: 100%;
  }

  .closing-flame {
    position: relative;
    margin-bottom: 2.25rem;
  }

  .closing-flame::before {
    content: '';
    position: absolute;
    inset: -40%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(242 56 24 / 0.32), rgb(255 152 0 / 0.1) 55%, transparent);
    filter: blur(24px);
  }


  .closing h2 {
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 760;
    letter-spacing: -0.045em;
  }

  .closing .lede {
    margin-top: 1rem;
  }

  .closing .actions {
    justify-content: center;
  }

  .closing :global(.closing-embers) {
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: 0;
    height: clamp(7rem, 14vw, 11rem);
    z-index: -1;
    -webkit-mask: linear-gradient(to bottom, transparent, #000 55%);
    mask: linear-gradient(to bottom, transparent, #000 55%);
  }

  @media (max-width: 1000px) {
    .kept,
    .tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 900px) {
    .hero-row,
    .split,
    .faq {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-row {
      align-items: start;
    }

    .hero-stats {
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .hero-stats div {
      padding-left: 0;
    }
  }

  @media (max-width: 560px) {
    .kept {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    .hero-stats div {
      grid-template-columns: 5.4rem minmax(0, 1fr);
    }

    .hero-stats dt {
      font-size: 1.9rem;
    }

    .tools {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.1rem;
    }

    .closing-flame :global(.pixels) {
      width: 100px;
      height: 100px;
    }
  }
</style>

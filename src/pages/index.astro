---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import CopyCommand from '../components/CopyCommand.astro';
import BenchPairs from '../components/BenchPairs.astro';
import ConsoleTabs from '../components/ConsoleTabs.astro';
import Services from '../components/Services.astro';
import KeepData from '../components/KeepData.astro';
import TestRun from '../components/TestRun.astro';
import AgentSession from '../components/AgentSession.astro';
import Pixels from '../components/Pixels.astro';
import Embers from '../components/Embers.astro';
import { site, notEmulated } from '../lib/site';
import { benchmark, pairs } from '../lib/benchmarks';
import { homeFaqs } from '../lib/faqs';
import { graph, organization, website, application, faqPage } from '../lib/schema';
import mcpTools from '../data/mcp-tools.json';

const pair = (label: string) => {
  const found = pairs.find((entry) => entry.label === label);
  if (!found) throw new Error(`no benchmark row "${label}"`);
  return found;
};
const write = pair('Write, median');
const memory = pair('Memory at peak');
const restart = pair('Restart with data kept');
const stats = [
  { lead: write.claim.split(' ')[0], text: 'faster writes', detail: `${write.firenook} ${write.unit} against ${write.official} ${write.unit}, median` },
  { lead: memory.claim.split(' ')[0], text: 'less memory', detail: `${memory.firenook} ${memory.unit} against ${memory.official} ${memory.unit} at peak` },
  { lead: `${restart.firenook} s`, text: 'to restart with your data', detail: `against ${restart.official} ${restart.unit}` },
];

const kept = [
  { title: 'firebase.json and .firebaserc', text: 'Read the way the Firebase CLI reads them.' },
  { title: 'Rules, indexes, Functions', text: 'Your code and config stay as they are.' },
  { title: 'Your SDKs', text: 'connectFirestoreEmulator, FIRESTORE_EMULATOR_HOST and the rest connect unchanged.' },
  { title: 'Your data', text: 'Imports and exports the official format, both ways.' },
];

// What an agent can do, by the tools' own groups.
const toolGroups = [
  { name: 'Firestore', can: 'Read, query, count, write and delete documents' },
  { name: 'Authentication', can: 'Manage users, read sign-in codes, mint ID tokens, set claims' },
  { name: 'Storage', can: 'List, read, upload, copy, move and delete files' },
  { name: 'Functions and logs', can: 'Invoke a function, read each call and the log, replay a call after a fix' },
  { name: 'Security Rules', can: 'Ask why a request is denied, test a draft, list denials' },
  { name: 'Pub/Sub, Tasks, Eventarc', can: 'Publish, peek, run tasks and schedules now, replay events' },
];

const steps = [
  {
    title: 'Install it next to firebase-tools',
    text: 'Keep firebase-tools for deploying. --save-exact keeps you on this release until you upgrade on purpose.',
    command: site.install,
  },
  {
    title: 'Check your project',
    text: 'This reads firebase.json the way the Firebase CLI does, and changes nothing.',
    command: 'npx firenook init --adopt --dry-run',
  },
  {
    title: 'Swap the command',
    text: 'Same flags and ports, so your app connects as before and your data imports as it is.',
    command: 'npx firenook emulators:start',
  },
];

// The questions in two columns, each column its own list, so opening one
// never moves the other.
const half = Math.ceil(homeFaqs.length / 2);
const faqColumns = [homeFaqs.slice(0, half), homeFaqs.slice(half)];

const schema = graph(organization, website, application, faqPage(homeFaqs));
---

<Base
  title="Firenook: a drop-in replacement for the Firebase Local Emulator Suite"
  description={site.description}
  schema={schema}
>
  <section class="hero">
    <div class="wrap hero-intro">
      <a class="release" href={site.release.url}>
        <span class="release-version">{site.version}</span>
        <span class="release-title">{site.release.title}</span>
      </a>
      <h1>A drop-in replacement for the Firebase Local Emulator&nbsp;Suite</h1>
      <p class="lede">
        Keep your <code>firebase.json</code>, SDKs and ports, and change one word in your script. No Java to install, and
        your data survives restarts.
      </p>
      <div class="actions">
        <CopyCommand command={site.install} />
        <a class="button button-primary" href="/docs/get-started/install">Get started</a>
      </div>
      <p class="hero-small">Free and open source under Apache 2.0. {site.requirements}.</p>
    </div>
    <div class="wrap hero-stage">
      <dl class="hero-stats" aria-label="Measured against the official emulator on a real application">
        {
          stats.map((stat) => (
            <div>
              <dt class="lit">{stat.lead}</dt>
              <dd>
                <span>{stat.text}</span>
                <small>{stat.detail}</small>
              </dd>
            </div>
          ))
        }
      </dl>
      <Terminal />
    </div>
  </section>

  <section class="section one-word" aria-labelledby="one-word">
    <div class="wrap">
      <div class="head">
        <h2 id="one-word">Change one word</h2>
        <p class="lede">
          Same flags, same ports, same export format. Your project stays as it is, and firebase-tools stays for deploying.
        </p>
      </div>
      <div class="one-word-body">
        <figure class="diff">
          <figcaption class="diff-file">package.json</figcaption>
          <pre aria-label="In your scripts, firebase becomes firenook"><span class="diff-line diff-old"><span class="diff-sign">-</span>  "emulators": "<mark>firebase</mark> emulators:start --import ./data"</span><span class="diff-line diff-new"><span class="diff-sign">+</span>  "emulators": "<mark>firenook</mark> emulators:start --import ./data"</span></pre>
        </figure>
        <ul class="kept">
          {
            kept.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services">
    <div class="wrap">
      <div class="head">
        <h2 id="services">Eight emulators, on the ports you already use</h2>
        <p class="lede">
          Your SDKs connect to them as they connect to Google’s: the same hosts, the same ports, the same environment
          variables.
        </p>
      </div>
      <div class="block">
        <Services />
      </div>
      <p class="note">
        The orders, users, files and calls above are from a run of the demo project, as Firenook returned them.{' '}
        {notEmulated.slice(0, -1).join(', ')} and {notEmulated.at(-1)} are not emulated; a <code>firebase.json</code> that
        configures them still starts, with a warning. <a href="/compatibility">What each service covers</a>.
      </p>
    </div>
  </section>

  <section class="section band" aria-labelledby="measured">
    <div class="wrap">
      <div class="head">
        <h2 id="measured">Measured on a real application</h2>
        <p class="lede">
          Two hours of a production app’s traffic against each emulator in turn, every operation timed by the client.
        </p>
      </div>
      <div class="block">
        <BenchPairs />
      </div>
      <p class="note">
        The app holds 211,205 Firestore documents and 6.7 GB in Storage; both emulators ran on one server. The official
        emulator answered {benchmark.queryShapesOfficialWins} of {benchmark.queryShapes} query shapes faster: ordering and
        range filters over a large collection, and batch gets of many documents.{' '}
        <a href="/benchmarks">How it was measured</a>.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="data-stays">
    <div class="wrap split">
      <div class="head">
        <h2 id="data-stays">Your data stays where you left it</h2>
        <p class="lede">
          Add <code>--keep-data</code> and Firestore, Auth and Storage come back with all your data in about half a second,
          even with millions of documents. No export at every stop, no import at every start.
        </p>
        <p class="prose">
          A crash loses at most the last second of writes, where the official emulator loses everything since its last
          export. A stop always closes the data cleanly.
        </p>
        <div class="actions">
          <CopyCommand command="npx firenook emulators:start --keep-data" />
        </div>
      </div>
      <KeepData />
    </div>
  </section>

  <section class="section band" aria-labelledby="tests">
    <div class="wrap split split-flip">
      <TestRun />
      <div class="head">
        <h2 id="tests">Run your tests against it</h2>
        <p class="lede">
          <code>emulators:exec</code> starts the suite, runs your command once everything is ready, with the emulator
          variables set, then stops and passes on the exit code.
        </p>
        <p class="prose">
          CI gets plain lines, the same ones the official emulator prints, and there is no Java to set up first. Firenook
          needs only Node 24.
        </p>
        <div class="actions">
          <CopyCommand command={'npx firenook emulators:exec "npm test"'} />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="console">
    <div class="wrap">
      <div class="head">
        <h2 id="console">The console the Firebase emulators should have had</h2>
        <p class="lede">
          Google’s Emulator UI has no page for your Functions, Pub/Sub, Cloud Tasks or Eventarc, only a log. Firenook’s
          console covers every service it runs, live, on the Emulator UI’s port.
        </p>
      </div>
      <div class="block">
        <ConsoleTabs />
      </div>
      <p class="note">
        Light and dark, works offline, sends nothing anywhere. Bookmarks to the official UI’s pages open the matching console
        page. <a href="/console">Every page of the console</a>.
      </p>
    </div>
  </section>

  <section class="section band" aria-labelledby="agents">
    <div class="wrap split split-agent">
      <div class="head">
        <h2 id="agents">Give your agent the emulator, not production</h2>
        <p class="lede">
          <code>firenook mcp</code> gives a coding agent {mcpTools.tools.length} tools over the running suite. It reads the
          log and each function call with its error, asks the Security Rules why a request is denied, and works with your
          data. Nothing leaves your machine.
        </p>
        <div class="actions">
          <CopyCommand command="npx firenook mcp add" />
        </div>
        <p class="prose">
          Sets it up for Claude Code, Cursor and VS Code in the project’s own files. Other agents run{' '}
          <code>npx firenook mcp</code>. <a href="/mcp">How agents use it</a>.
        </p>
      </div>
      <AgentSession />
    </div>
    <div class="wrap">
      <dl class="tools" aria-label={`What the ${mcpTools.tools.length} tools do`}>
          {
            toolGroups.map((group) => (
              <div>
                <dt>{group.name}</dt>
                <dd>{group.can}</dd>
              </div>
            ))
          }
        </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="questions">
    <div class="wrap">
      <div class="head">
        <h2 id="questions">Questions</h2>
        <p class="lede">
          Something else? <a href={site.issues}>Ask on GitHub</a>, or read <a href="/docs">the docs</a>.
        </p>
      </div>
      <div class="faq">
        {
          faqColumns.map((column) => (
            <div class="faq-list">
              {column.map((faq) => (
                <details>
                  <summary>{faq.question}</summary>
                  <p>{faq.answer}</p>
                </details>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="closing" aria-labelledby="try">
    <div class="wrap">
      <div class="closing-head">
        <div class="closing-flame cells-glow">
          <Pixels art="flame" size={100} />
        </div>
        <div class="head">
          <h2 id="try">Switch in three steps</h2>
          <p class="lede">
            One package, nothing else to install. Starting a new project instead? <code>npx firenook init</code> sets one up.
          </p>
        </div>
      </div>
      <ol class="steps">
        {
          steps.map((step, index) => (
            <li>
              <span class="step-number" aria-hidden="true">
                {index + 1}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              <CopyCommand command={step.command} wrap />
            </li>
          ))
        }
      </ol>
      <div class="actions closing-actions">
        <a class="button button-primary" href="/docs/get-started/install">Read the getting started guide</a>
        <a class="button button-quiet" href={site.repo}>Firenook on GitHub</a>
      </div>
    </div>
    <Embers class="closing-embers" columns={110} rows={14} seed={23} />
  </section>
</Base>

<style>
  /* The first screen: the words centred over the terminal, and the
     measured numbers in a row as wide as it, so the three share one axis. */
  .hero {
    position: relative;
    overflow-x: clip;
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }

  /* Centred items take their own width; none may pass the page's. */
  .hero-intro > * {
    max-width: 100%;
  }

  .hero-intro :global(.copy-command code) {
    text-align: left;
  }

  .release {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 100%;
    margin-bottom: 1.5rem;
    padding: 0.3rem 0.85rem 0.3rem 0.35rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.03);
    color: var(--smoke);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  .release:hover {
    border-color: rgb(255 255 255 / 0.28);
    color: var(--ink);
  }

  .release-version {
    flex: none;
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    background: rgb(242 56 24 / 0.16);
    color: #ffb199;
    font-family: var(--mono);
    font-size: var(--text-xs);
  }

  .release-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero h1 {
    max-width: 16em;
    font-size: var(--text-h1);
    font-weight: 780;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .hero .lede {
    max-width: 32em;
    margin-top: 1.25rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }

  .hero .actions {
    justify-content: center;
    margin-top: 1.75rem;
  }

  .actions :global(.copy-command) {
    max-width: 100%;
  }

  .hero-small {
    margin-top: 0.9rem;
    color: var(--ash);
    font-size: var(--text-xs);
  }

  .hero-stage {
    margin-top: clamp(2.75rem, 5vw, 3.75rem);
    padding-bottom: clamp(5rem, 8vw, 7rem);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 58rem;
    margin: 0 auto 1.75rem;
    border-block: 1px solid var(--line);
  }

  .hero-stats div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.25rem;
  }

  .hero-stats div + div {
    border-left: 1px solid var(--line);
  }

  .hero-stats dt {
    font-size: var(--text-num);
    font-weight: 780;
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
  }

  .hero-stats dd {
    display: grid;
    gap: 0.1rem;
    margin: 0;
  }

  .hero-stats dd span {
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
  }

  .hero-stats small {
    color: var(--ash);
    font-size: var(--text-xs);
    line-height: 1.35;
  }

  /* Shared pieces */
  .block {
    margin-top: clamp(2rem, 3.5vw, 2.75rem);
  }

  /* Small print under an artefact, like a figure's caption: its edge on the
     content's centre line (between the second and third service cards), and
     the whole width on a phone. */
  .note {
    max-width: max(calc(50% - 0.5rem), 34rem);
    margin-top: 1.5rem;
    color: var(--ash);
    font-size: var(--text-xs);
  }

  /* A raised band, so the page has a rhythm of grounds. */
  .band {
    border-block: 1px solid var(--line);
    background: #161619;
  }

  /* Words beside the artefact. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .split .head {
    align-content: start;
  }

  .split .actions {
    margin-top: 0.3rem;
  }

  .split-flip {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }


  /* Change one word */
  .one-word {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  /* The same two columns as the heading above, so the edges line up. */
  .one-word-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem clamp(2rem, 6vw, 5rem);
    align-items: start;
    margin-top: clamp(2rem, 3.5vw, 2.75rem);
  }

  .diff {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    background: var(--cinder);
  }

  .diff-file {
    padding: 0.65rem 1.15rem;
    border-bottom: 1px solid var(--line);
    color: var(--smoke);
    font: 560 var(--text-xs) / 1.2 var(--mono);
  }

  .diff pre {
    margin: 0;
    overflow-x: auto;
    padding: 0.9rem 0;
    font-size: var(--text-sm);
    line-height: 1.95;
  }

  .diff-line {
    display: block;
    padding: 0 1.15rem;
  }

  .diff-sign {
    display: inline-block;
    width: 1.5ch;
  }

  .diff-old {
    background: rgb(255 106 95 / 0.08);
    color: #ffb1aa;
  }

  .diff-new {
    background: rgb(76 195 138 / 0.08);
    color: #a6ebc6;
  }

  .diff mark {
    padding: 0.05em 0.15em;
    border-radius: 4px;
    color: #fff;
  }

  .diff-old mark {
    background: rgb(255 106 95 / 0.42);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }

  .diff-new mark {
    background: rgb(76 195 138 / 0.42);
  }

  .kept {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kept li {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line-strong);
  }

  .kept h3,
  .tools dt {
    color: var(--ink);
    font-size: var(--text-md);
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .kept p,
  .tools dd {
    margin: 0;
    color: var(--smoke);
    font-size: var(--text-sm);
  }

  /* Agents */
  .tools {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem clamp(1.5rem, 3vw, 2.5rem);
    margin: clamp(2.5rem, 4vw, 3.25rem) 0 0;
  }

  .tools div {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line-strong);
  }

  /* Questions */
  .faq {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(2rem, 6vw, 5rem);
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .faq-list details {
    border-bottom: 1px solid var(--line);
  }

  .faq-list details:first-child {
    border-top: 1px solid var(--line);
  }

  .faq-list summary {
    position: relative;
    padding: 1.05rem 2.25rem 1.05rem 0;
    color: var(--ink);
    font-size: var(--text-md);
    font-weight: 620;
    cursor: pointer;
    list-style: none;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list summary::after {
    content: '';
    position: absolute;
    right: 0.25rem;
    top: 50%;
    width: 0.55rem;
    height: 0.55rem;
    border-right: 1.6px solid var(--smoke);
    border-bottom: 1.6px solid var(--smoke);
    transform: translateY(-70%) rotate(45deg);
    transition: transform 160ms ease;
  }

  .faq-list details[open] summary::after {
    transform: translateY(-30%) rotate(225deg);
  }

  .faq-list details p {
    max-width: 38em;
    padding-bottom: 1.2rem;
    color: var(--smoke);
    font-size: var(--text-md);
  }

  /* The fire, once more, and the way in. */
  .closing {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3.5rem, 6vw, 5.25rem);
    border-top: 1px solid var(--line);
    padding-bottom: clamp(8rem, 13vw, 11rem);
    isolation: isolate;
  }

  .closing-head {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .closing-flame {
    position: relative;
    flex: none;
  }

  .closing-flame::before {
    content: '';
    position: absolute;
    inset: -45%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(242 56 24 / 0.32), rgb(255 152 0 / 0.1) 55%, transparent);
    filter: blur(22px);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: clamp(2rem, 3.5vw, 2.75rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
    padding: 1.35rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: linear-gradient(180deg, #1c1c20, #18181b);
  }

  .step-number {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    margin-bottom: 0.3rem;
    border: 1px solid var(--line-strong);
    border-radius: 7px;
    background: var(--hearth-2);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .steps h3 {
    font-size: var(--text-lg);
  }

  .steps p {
    color: var(--smoke);
    font-size: var(--text-sm);
  }

  .steps :global(.copy-command) {
    width: 100%;
    margin-top: auto;
  }

  .closing-actions {
    margin-top: 1.75rem;
  }

  .closing :global(.closing-embers) {
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: 0;
    height: clamp(6rem, 12vw, 9.5rem);
    z-index: -1;
    -webkit-mask: linear-gradient(to bottom, transparent, #000 55%);
    mask: linear-gradient(to bottom, transparent, #000 55%);
  }


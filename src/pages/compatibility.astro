---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Pixels from '../components/Pixels.astro';
import Closing from '../components/Closing.astro';
import CaseWall from '../components/CaseWall.astro';
import Growth from '../components/Growth.astro';
import history from '../data/conformance/history.json';
import { page } from '../lib/pages';
import { site, services } from '../lib/site';
import { surfaces, notEmulated, platforms, record as compatibilityRecord, knownIssues, choices, found } from '../lib/compatibility';
import { record, formatCount, formatDay, referenceLabel, type RecordedSet } from '../lib/conformance';
import type { ArtName } from '../lib/pixels';
import { graph, organization, website, breadcrumbs } from '../lib/schema';

const meta = page('/compatibility');
// The block icon of each emulator, where it has one; the hub's is the console's window.
const own: Record<string, ArtName> = { console: 'console', cli: 'cli', configuration: 'config' };
const art = (id: string) => (own[id] ?? services.find((service) => service.id === id)?.art) as ArtName | undefined;

const schema = graph(
  organization,
  website,
  breadcrumbs([
    { name: 'Firenook', path: '/' },
    { name: meta.crumb, path: '/compatibility' },
  ]),
);

// Which recorded services each section of the page shows.
const recordedFor: Record<string, string[]> = {
  firestore: ['firestore', 'firestore-rules'],
  auth: ['auth'],
  storage: ['storage', 'storage-rules'],
  functions: ['functions'],
  pubsub: ['pubsub'],
  tasks: ['tasks'],
  console: ['suite'],
};
const byService = new Map(record.services.map((service) => [service.id, service]));
// A deliberate difference was replayed too: replayed is checked or differs.
const productionReplayed = record.services
  .flatMap((service) => service.sets)
  .filter((set) => set.kind === 'production')
  .reduce((sum, set) => sum + set.checked + set.differs, 0);
const replayed = (set: { checked: number; differs: number }) => set.checked + set.differs;
const first = history[0];
const latest = history[history.length - 1];
const fromLabel = (set: RecordedSet) => (set.kind === 'production' ? `${set.reference}` : referenceLabel(set));
// A section's recorded groups: named for what they cover when there are two,
// so a title never repeats the section's own name.
const groupTitle: Record<string, string> = {
  firestore: 'Data, queries and listeners',
  'firestore-rules': 'Security Rules',
  storage: 'Files and metadata',
  'storage-rules': 'Security Rules',
};
// What a section with nothing recorded of its own says instead.
const unrecorded: Record<string, string> = {
  extensions: 'Recorded with Cloud Functions: the Functions runtime’s recordings include Extensions.',
  cli: 'Its start, stop and restart are recorded with the hub, under Hub and console.',
};
// Code in a sentence, written between backticks in the data or as a flag, is
// set as code, so it reads as code and never breaks after its dashes.
const withCode = (text: string) =>
  text
    .split(/(`[^`]+`|--[a-z][a-z-]*)/g)
    .filter(Boolean)
    .map((part) => ({ code: part.startsWith('`') || part.startsWith('--'), text: part.replace(/^`|`$/g, '') }));
const fixedTotal = found.reduce((sum, release) => sum + release.items.length, 0);
const fixingCount = fixedTotal - found.reduce((sum, release) => sum + (release.date ? release.items.length : 0), 0);
const fixedCount = found.reduce((sum, release) => sum + (release.date ? release.items.length : 0), 0);
---

<Base title={meta.title} description={meta.description} schema={schema}>
  <PageHead title="Checked against Firebase’s own answers">
    <Fragment slot="lede">
      Each block in the wall below is a request recorded from the official emulator or from production Firebase, with
      the answer it gave. A lit block is one Firenook’s tests replay on every change and answer the same way, an
      outlined one is replayed and answered differently on purpose, and a grey one is waiting for its replay.
    </Fragment>
    <nav class="jump" aria-label="Services on this page">
      {surfaces.map((surface) => <a href={`#${surface.id}`}>{surface.name}</a>)}
    </nav>
  </PageHead>

  <section class="section record" aria-labelledby="record">
    <div class="wrap">
      <h2 id="record" class="visually-hidden">The record</h2>
      <ul class="measures">
        <li>
          <span class="measure lit">{formatCount(record.total)}</span>
          <span class="measure-label">answers recorded from Firebase</span>
        </li>
        <li>
          <span class="measure lit">{formatCount(record.checked + record.differs)}</span>
          <span class="measure-label">replayed against Firenook on every change</span>
        </li>
        <li>
          <span class="measure lit">{formatCount(productionReplayed)}</span>
          <span class="measure-label">of the {formatCount(record.production)} from production</span>
        </li>
        <li>
          <span class="measure lit">+{formatCount(latest.total - first.total)}</span>
          <span class="measure-label">since the first public preview</span>
        </li>
      </ul>
      <CaseWall />
      <p class="note">
        Point at or tap a block to see what was asked, what Firebase answered and what the replay compares. Production’s
        answers come from Cloud Firestore and the Firebase Rules API, in projects that hold only made-up data.{' '}
        <a href={site.repo + '/tree/main/conformance'}>The recordings on GitHub</a>
      </p>
    </div>
  </section>

  <section class="section band" aria-labelledby="growth">
    <div class="wrap">
      <div class="head">
        <h2 id="growth">More of Firebase recorded, release by release</h2>
        <p class="lede">
          From {formatCount(first.total)} answers at the first public preview to {formatCount(latest.total)} in {latest.release}.
          Each release adds what the one before did not check yet.
        </p>
      </div>
      <Growth />
    </div>
  </section>

  {
    surfaces.map((surface, index) => {
      const recorded = (recordedFor[surface.id] ?? []).map((id) => byService.get(id)).filter((service) => service && service.answers > 0);
      return (
        <section class:list={['section', 'surface', { band: index % 2 === 1 }]} aria-labelledby={surface.id}>
          <div class="wrap">
            <div class="surface-head">
              {art(surface.id) && <Pixels art={art(surface.id)!} size={30} gap={0} />}
              <div class="head">
                <h2 id={surface.id}>{surface.name}</h2>
                <p class="lede">
                  {surface.summary}
                  {surface.port && <span class="port"> {surface.port.includes(' and ') ? 'Ports' : 'Port'} {surface.port}.</span>}
                </p>
              </div>
            </div>
            {recorded.length > 0 ? (
              <div class="recorded block">
                {recorded.map((service) => (
                  <div class="recorded-group" id={service!.anchor !== surface.id ? service!.anchor : undefined}>
                    <h3 class="recorded-title">
                      {groupTitle[service!.id] ?? 'Recorded answers'}
                      <span class="recorded-total">
                        {formatCount(replayed(service!))} of {formatCount(service!.answers)} replayed
                        {service!.production > 0 && <>, {formatCount(service!.production)} recorded from production</>}
                      </span>
                    </h3>
                    <ul class="sets">
                      {service!.listed
                        .map((index) => service!.sets[index])
                        .filter((set) => set.answers > 0)
                        .map((set, index, sets) => (
                          <li class="set">
                            <span class="set-area">{index > 0 && sets[index - 1].area === set.area ? '' : set.area}</span>
                            <span class="set-from">
                              <span class:list={['set-kind', `set-${set.kind}`]} aria-hidden="true" />
                              <span>
                                {fromLabel(set)}
                                {set.recordedAt && <span class="set-date">{formatDay(set.recordedAt)}</span>}
                              </span>
                            </span>
                            <span class:list={['set-count', { partial: replayed(set) < set.answers }]}>
                              {replayed(set) === set.answers ? formatCount(set.answers) : `${formatCount(replayed(set))} of ${formatCount(set.answers)}`}
                            </span>
                          </li>
                        ))}
                    </ul>
                  </div>
                ))}
              </div>
            ) : (
              <p class="unrecorded block">
                <span class="cold-block" aria-hidden="true" />
                {unrecorded[surface.id] ?? 'Nothing recorded from Firebase yet: Firenook’s own tests check it, and recordings come next.'}
              </p>
            )}
            <details class="covers block">
              <summary>What it covers, and what it does not</summary>
              <div class:list={['columns', { three: surface.differs }]}>
                <div>
                  <h3>Covered</h3>
                  <ul class="list list-yes">{surface.covers.map((line) => <li>{line}</li>)}</ul>
                </div>
                <div>
                  <h3>Not claimed</h3>
                  <ul class="list list-no">{surface.notClaimed.map((line) => <li>{line}</li>)}</ul>
                </div>
                {surface.differs && (
                  <div>
                    <h3>Different on purpose</h3>
                    <ul class="list list-diff">{surface.differs.map((line) => <li>{line}</li>)}</ul>
                  </div>
                )}
              </div>
            </details>
          </div>
        </section>
      );
    })
  }

  <section class="section band" aria-labelledby="choices">
    <div class="wrap">
      <div class="head">
        <h2 id="choices">Where Firenook takes a side</h2>
        <p class="lede">
          Where the official emulator and production answer differently, a test that passes locally should pass in
          production too. So Firenook gives production’s answer, or lets you choose. The answer it gives is in white.
        </p>
      </div>
      <div class="table-scroll block">
        <table class="table choices">
          <thead>
            <tr>
              <th scope="col">When</th>
              <th scope="col">The official emulator</th>
              <th scope="col">Production</th>
              <th scope="col">Firenook</th>
            </tr>
          </thead>
          <tbody>
            {
              choices.map((choice, index) => (
                <tr>
                  <th scope="row">
                    {(index === 0 || choices[index - 1].area !== choice.area) && (
                      <span class="choice-area">{choice.area}</span>
                    )}
                    {withCode(choice.behaviour).map((part) => (part.code ? <code>{part.text}</code> : part.text))}
                  </th>
                  <td data-label="The official emulator" class:list={{ win: choice.follows === 'yours' }}>
                    {withCode(choice.official).map((part) => (part.code ? <code>{part.text}</code> : part.text))}
                  </td>
                  <td data-label="Production" class="win">
                    {withCode(choice.production).map((part) => (part.code ? <code>{part.text}</code> : part.text))}
                  </td>
                  <td data-label="Firenook" class="firenook">
                    {withCode(choice.firenook).map((part) => (part.code ? <code>{part.text}</code> : part.text))}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="found">
    <div class="wrap">
      <div class="head">
        <h2 id="found">Every difference found becomes a test</h2>
        <p class="lede">
          People running Firenook against their own projects found {fixedTotal} answers it gave differently:{' '}
          {fixedCount} are fixed and {fixingCount} are being fixed now. Each fix lands with a test that runs on every change, and where a
          recording settles it, the recording joins the wall.
        </p>
      </div>
      <ol class="releases block">
        {
          found.map((release) => (
            <li class:list={['release', { upcoming: !release.date }]}>
              <div class="release-head">
                <span class="release-block" aria-hidden="true" />
                <span class="release-name">{release.date ? `Fixed in ${release.release}` : 'Being fixed for the next release'}</span>
                {release.date && <span class="release-date">{formatDay(release.date)}</span>}
              </div>
              <ul class="found-list">
                {release.items.map((item, index) => (
                  <li>
                    <span class="found-area">{index > 0 && release.items[index - 1].area === item.area ? '' : item.area}</span>
                    <p>
                      {withCode(item.text).map((part) => (part.code ? <code>{part.text}</code> : part.text))}
                      {item.recorded && <span class="found-recorded"> Now recorded from the official emulator.</span>}{' '}
                      <a href={`${site.repo}/${item.kind === 'pull' ? 'pull' : 'issues'}/${item.number}`}>#{item.number}</a>
                    </p>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
      <p class="note">
        Found something else? <a href={site.issues}>Open an issue</a> with what the official emulator answers and what Firenook
        answers.
      </p>
    </div>
  </section>

  <section class="section band" aria-labelledby="not-emulated">
    <div class="wrap columns-2">
      <div class="head">
        <h2 id="not-emulated">Not emulated</h2>
        <p class="lede">{notEmulated.services.join(', ').replace(/, ([^,]*)$/, ' and $1')}. {notEmulated.text}</p>
        <p class="prose">Keep the official emulator for those, or run it beside Firenook on other ports.</p>
      </div>
      <div class="head">
        <h2 id="platforms">Platforms</h2>
        <p class="lede">{platforms.supported.join('; ')}, each checked with a packed install on every release.</p>
        <p class="prose">{platforms.node}</p>
        <p class="prose">Not supported or not yet qualified: {platforms.notQualified.join('; ')}.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="known-issues">
    <div class="wrap">
      <div class="head">
        <h2 id="known-issues">Known issues in {site.version}</h2>
        <p class="lede">
          What is wrong in this release, found while these docs were checked against it. Each one links to the way around
          it.
        </p>
      </div>
      <ul class="issues block">
        {
          knownIssues.map((issue, index) => (
            <li>
              <span class="issue-area">{index > 0 && knownIssues[index - 1].area === issue.area ? '' : issue.area}</span>
              <p>
                {withCode(issue.text).map((part) => (part.code ? <code>{part.text}</code> : part.text))}{' '}
                <a href={issue.href}>The way around it</a>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Closing id="check" title="Check your own project">
    <Fragment slot="lede">
      <code>init --adopt --dry-run</code> reads your <code>firebase.json</code> the way Firenook will and says what it runs,
      what it skips and why, without changing a thing.
    </Fragment>
    <div class="actions">
      <a class="button button-primary" href="/docs/get-started/switch">Switch from the Firebase emulators</a>
      <a class="button button-quiet" href={compatibilityRecord}>The record on GitHub</a>
    </div>
  </Closing>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.75rem;
  }

  .jump a {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--smoke);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  .jump a:hover {
    border-color: rgb(255 255 255 / 0.3);
    color: var(--ink);
  }

  .block {
    margin-top: 2rem;
  }

  .note {
    max-width: 46rem;
    margin-top: 1.25rem;
    color: var(--ash);
    font-size: var(--text-xs);
  }

  /* The record: four lit numbers, then the wall, right under the header. */
  .record {
    padding-top: clamp(2.25rem, 4vw, 3rem);
  }

  .measures {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0 0 2.25rem;
    padding: 0;
    list-style: none;
  }

  .measures li {
    display: grid;
    align-content: start;
    gap: 0.2rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line-strong);
  }

  .measure {
    font-size: var(--text-num);
    font-weight: 780;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .measure-label {
    color: var(--smoke);
    font-size: var(--text-sm);
  }

  /* Each section: its sets as bars of blocks, then what it covers. */
  .surface-head {
    display: flex;
    align-items: start;
    gap: 1.1rem;
  }

  .surface-head :global(.pixels) {
    flex: none;
    margin-top: 0.4rem;
  }

  .port {
    color: var(--ash);
  }

  .recorded {
    display: grid;
    gap: 2rem;
  }

  .recorded-group {
    scroll-margin-top: 6rem;
  }

  .recorded-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line-strong);
    color: var(--ink);
    font-size: var(--text-md);
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .recorded-total {
    color: var(--smoke);
    font-size: var(--text-sm);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }

  .sets {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .set {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) 7rem;
    gap: 0.4rem 1.5rem;
    align-items: start;
    padding-block: 0.65rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-sm);
  }

  .set-area {
    color: var(--ink);
  }

  .set-from {
    display: flex;
    gap: 0.6rem;
    color: var(--smoke);
  }

  /* The block of the wall's colour for the reference it was recorded from. */
  .set-kind {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 0.45em;
  }

  .set-production {
    background: #f4421a;
  }

  .set-official {
    background: #ff9d1c;
  }

  .set-date {
    display: block;
    color: var(--ash);
    font-size: var(--text-xs);
  }

  .set-count {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    text-align: right;
    white-space: nowrap;
  }

  /* Not every answer replayed yet: the count says how many are. */
  .set-count.partial {
    color: var(--smoke);
    font-weight: 500;
  }

  .unrecorded {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--smoke);
    font-size: var(--text-sm);
  }

  .cold-block {
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--cold);
  }

  .covers summary {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--link);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .covers summary::-webkit-details-marker {
    display: none;
  }

  .covers summary::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 120ms ease;
  }

  .covers[open] summary::before {
    transform: rotate(45deg);
  }

  .covers .columns {
    margin-top: 1.5rem;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem clamp(1.5rem, 4vw, 3rem);
  }

  .columns.three {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1fr);
  }

  .columns h3 {
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line-strong);
    color: var(--ink);
    font-size: var(--text-md);
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .list {
    display: grid;
    gap: 0.55rem;
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--smoke);
    font-size: var(--text-sm);
  }

  .list li {
    position: relative;
    padding-left: 1.35rem;
  }

  /* A lit block for what is covered, a cold one for what is not, an outline
     for a deliberate difference. */
  .list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
  }

  .list-yes li::before {
    background: var(--fire);
  }

  .list-no li::before {
    background: var(--cold);
  }

  .list-diff li::before {
    box-shadow: inset 0 0 0 1.5px var(--smoke);
  }

  /* Where it takes a side: Firenook's answer in ink, and production's where
     that is the one it gives. */
  .choices th[scope='row'] {
    min-width: 14rem;
  }

  .choice-area {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--ash);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .choices td.win,
  .choices td.firenook {
    color: var(--ink);
  }


  /* Found and fixed: one rail of releases. */
  .releases {
    display: grid;
    gap: 2.25rem;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  .release-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .release-block {
    width: 10px;
    height: 10px;
    background: var(--fire);
    box-shadow: 0 0 7px rgb(242 56 24 / 0.55);
  }

  .upcoming .release-block {
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--smoke);
  }

  .release-name {
    color: var(--ink);
    font-size: var(--text-md);
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .release-date {
    color: var(--ash);
    font-size: var(--text-sm);
  }

  .found-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .found-list li {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--smoke);
    font-size: var(--text-sm);
  }

  .found-area {
    color: var(--ink);
    font-weight: 600;
  }

  .found-recorded {
    color: var(--ash);
  }

  .issues {
    display: grid;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .issues li {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.4rem 1.5rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--line);
    color: var(--smoke);
    font-size: var(--text-sm);
  }

  .issue-area {
    color: var(--ink);
    font-weight: 600;
  }

  .columns-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .columns-2 > .head {
    align-content: start;
  }

  @media (max-width: 900px) {
    .measures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .columns,
    .columns.three,
    .columns-2 {

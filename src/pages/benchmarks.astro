---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import BenchPairs from '../components/BenchPairs.astro';
import FileFigure from '../components/FileFigure.astro';
import Closing from '../components/Closing.astro';
import CopyCommand from '../components/CopyCommand.astro';
import { page } from '../lib/pages';
import {
  benchmark,
  host,
  traffic,
  resources,
  restarts,
  grown,
  queryShapes,
  writesAlone,
  fairness,
  figure,
  limits,
} from '../lib/benchmarks';
import { graph, organization, website, breadcrumbs } from '../lib/schema';
import { site } from '../lib/site';

const meta = page('/benchmarks');

const dataset = {
  '@type': 'Dataset',
  name: 'Firenook against the official Firebase emulator',
  description: meta.description,
  url: `${site.url}/benchmarks`,
  creator: { '@id': `${site.url}/#organization` },
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  distribution: { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: benchmark.record },
  temporalCoverage: '2026-10-21/2026-10-22',
};

const schema = graph(
  organization,
  website,
  dataset,
  breadcrumbs([
    { name: 'Firenook', path: '/' },
    { name: meta.crumb, path: '/benchmarks' },
  ]),
);

const yourOwn = `$ time npx firebase emulators:exec "npm test"
$ time npx firenook emulators:exec "npm test"`;
---

<Base title={meta.title} description={meta.description} schema={schema}>
  <PageHead title="Firenook against the official emulator">
    <Fragment slot="lede">
      Two hours of a real application’s traffic against each emulator in turn, on one server, every operation timed by the
      client. Then each emulator on its own, for starts, stops, queries and a store of 2.7 million documents.
    </Fragment>
    <Fragment slot="actions">
      <a class="button button-quiet" href={benchmark.record}>The record on GitHub</a>
      <a class="button button-quiet" href="#method">How it ran</a>
    </Fragment>
  </PageHead>

  <section class="section" aria-labelledby="summary">
    <div class="wrap">
      <div class="head">
        <h2 id="summary">In short</h2>
        <p class="lede">
          Firenook against {benchmark.official}, measured on {benchmark.measured}. Lower is better on every row.
        </p>
      </div>
      <div class="block">
        <BenchPairs />
      </div>
      <p class="note">
        Memory, latency and CPU: one application, its data and the same two-hour workload, one emulator at a time. Restart
        and query: Firestore, Auth and Storage on the same data, no application. Every multiple is rounded down.
      </p>
    </div>
  </section>

  <section class="section band" aria-labelledby="method">
    <div class="wrap">
      <div class="head">
        <h2 id="method">What ran</h2>
        <p class="lede">One server, one real application and its data, and the same two hours of traffic for each emulator.</p>
      </div>
      <dl class="facts block method">
        <div>
          <dt>The server</dt>
          <dd>{host.machine}. One emulator at a time, official first, each from a clean start, nothing else running.</dd>
        </div>
        <div>
          <dt>The application</dt>
          <dd>
            A production web application with its API, a Functions codebase and a cache worker, on a copy of its data:{' '}
            {host.data}. Both stacks had to end with identical data.
          </dd>
        </div>
        <div>
          <dt>The traffic</dt>
          <dd>{host.traffic} Latency is timed by the client, from call to answer: {host.counted}.</dd>
        </div>
      </dl>
      <p class="note">
        The run passed every check: both soaks with exactly the same operations and no error, stall or lost update, 36 of 36
        browser journeys, identical data after every stage, and 95 evidence files re-verified by an independent audit.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="traffic">
    <div class="wrap">
      <div class="head">
        <h2 id="traffic">Two hours of an application’s traffic</h2>
        <p class="lede">Firenook was faster at the median and at the 99th percentile on every row.</p>
      </div>
      <div class="table-scroll block">
        <table class="table table-stack">
          <thead>
            <tr>
              <th scope="col">Median / 99th percentile</th>
              <th scope="col" class="num">Official</th>
              <th scope="col" class="num">Firenook</th>
              <th scope="col" class="num">Median</th>
            </tr>
          </thead>
          <tbody>
            {
              traffic.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td data-label="Official" class="num">{row.official}</td>
                  <td data-label="Firenook" class="num win">{row.firenook}</td>
                  <td data-label="Median" class="num">{row.faster} faster</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note">
        Within the Storage cycle, downloads were the one step where Firenook was not faster: 2.30 / 5.01 ms against 2.12 /
        4.31 ms.
      </p>
    </div>
  </section>

  <section class="section band" aria-labelledby="resources">
    <div class="wrap">
      <div class="head">
        <h2 id="resources">Memory, CPU and disk</h2>
        <p class="lede">
          The official emulator keeps all data in its Java heap, which grew for the whole run. Firenook keeps data on disk and
          caches what it reads.
        </p>
      </div>
      <div class="table-scroll block">
        <table class="table table-stack">
          <thead>
            <tr>
              <th scope="col">Over the two hours</th>
              <th scope="col" class="num">Official</th>
              <th scope="col" class="num">Firenook</th>
            </tr>
          </thead>
          <tbody>
            {
              resources.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td data-label="Official" class="num">{row.official}</td>
                  <td data-label="Firenook" class="num win">{row.firenook}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note">
        Most of what the official stack’s server wrote was swap: it paged out 3.1 GB, where Firenook’s paged out nothing.
        Firenook’s writes are its data, durable within a second. The application’s web server peaked at about 12.1 GiB on both.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="restarts">
    <div class="wrap">
      <div class="head">
        <h2 id="restarts">Start, stop and start again</h2>
        <p class="lede">
          To keep its data, the official emulator exports at every stop and imports at every start. Firenook keeps its data
          and picks it up.
        </p>
      </div>
      <div class="table-scroll block">
        <table class="table table-stack">
          <thead>
            <tr>
              <th scope="col">Firestore, Auth and Storage, no application</th>
              <th scope="col" class="num">Official</th>
              <th scope="col" class="num">Firenook</th>
            </tr>
          </thead>
          <tbody>
            {
              restarts.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td data-label="Official" class="num">{row.official}</td>
                  <td data-label="Firenook" class="num win">{row.firenook}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note">
        No Firenook start needed a repair. With the whole application, its builds included, the stack was ready in 55.7 s
        against 86.5 s, again in 42.9 s against 86.8 s after a restart, and stopped in 29.6 s against 79.8 s.
      </p>
    </div>
  </section>

  <section class="section band" aria-labelledby="grown">
    <div class="wrap">
      <div class="head">
        <h2 id="grown">A store grown to 2.7 million documents</h2>
        <p class="lede">
          The same data grown by 2,500,000 small documents, then started on each, with four queries on the grown collection.
          On Java’s defaults the official emulator ran out of memory at the first query.
        </p>
      </div>
      <div class="table-scroll block">
        <table class="table table-stack">
          <thead>
            <tr>
              <th scope="col">2,711,202 documents</th>
              {grown.columns.map((column) => <th scope="col" class="num">{column}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Start</th>
              {
                grown.start.map((value, index) => (
                  <td data-label={grown.columns[index]} class:list={['num', { win: index === 2 }]}>
                    {value}
                  </td>
                ))
              }
            </tr>
            <tr>
              <th scope="row">Memory</th>
              {
                grown.memory.map((value, index) => (
                  <td data-label={grown.columns[index]} class:list={['num', { win: index === 2 }]}>
                    {value}
                  </td>
                ))
              }
            </tr>
            {
              grown.queries.map((row) => (
                <tr>
                  <th scope="row">{row.shape}</th>
                  <td data-label={grown.columns[0]} class="num">
                    Failed
                  </td>
                  <td data-label={grown.columns[1]} class="num">
                    {row.official.toLocaleString('en-US')} ms
                  </td>
                  <td data-label={grown.columns[2]} class="num win">
                    {row.firenook.toLocaleString('en-US')} ms
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note">
        The official emulator imported the data from a 9.81 GB export. Firenook walks an ordered index to the 20 documents
        asked for, however large the collection.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="queries">
    <div class="wrap">
      <div class="head">
        <h2 id="queries">{queryShapes.length} query shapes</h2>
        <p class="lede">
          Each shape warmed up once, then run 25 times over gRPC against the same data. Every answer was the same on both.
          Firenook was faster on {benchmark.queryShapesFaster} and tied on the last.
        </p>
      </div>
      <div class="table-scroll block">
        <table class="table table-stack">
          <thead>
            <tr>
              <th scope="col">Shape</th>
              <th scope="col" class="num">Official p50</th>
              <th scope="col" class="num">Firenook p50</th>
              <th scope="col" class="num">Official p99</th>
              <th scope="col" class="num">Firenook p99</th>
              <th scope="col" class="num">Faster</th>
            </tr>
          </thead>
          <tbody>
            {
              queryShapes.map((row) => (
                <tr>
                  <th scope="row">{row.shape}</th>
                  <td data-label="Official p50" class="num">{figure(row.official[0])}</td>
                  <td data-label="Firenook p50" class:list={['num', { win: row.times !== 'tie' }]}>{figure(row.firenook[0])}</td>
                  <td data-label="Official p99" class="num">{figure(row.official[1])}</td>
                  <td data-label="Firenook p99" class="num">{figure(row.firenook[1])}</td>
                  <td data-label="Faster" class="num">{row.times === 'tie' ? 'Tie' : `Firenook, ${row.times}`}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note">
        Milliseconds; Firenook’s figure is the median of three rounds. Firenook serves orderBy, range filters and cursors on a
        top-level field from an ordered index, and checks equality filters on other fields before it reads a document. The
        tie, 500 document ids with no fields, reads each document whole before dropping its fields; reading only the ids is
        a next step.
      </p>
    </div>
  </section>

  <section class="section band" aria-labelledby="writes">
    <div class="wrap">
      <div class="head">
        <h2 id="writes">Writes on their own</h2>
        <p class="lede">
          Firestore alone on the same server, on fresh copies of the same store: 2,000 writes one at a time, each confirmed
          by a listener, then 4,000 from eight writers at once.
        </p>
      </div>
      <div class="table-scroll block">
        <table class="table table-stack">
          <thead>
            <tr>
              <th scope="col">Round</th>
              <th scope="col" class="num">Write, median / p99</th>
              <th scope="col" class="num">Listener, median</th>
              <th scope="col" class="num">Eight writers</th>
            </tr>
          </thead>
          <tbody>
            {
              writesAlone.map((row) => (
                <tr>
                  <th scope="row">{row.round}</th>
                  <td data-label="Write, median / p99" class="num">{row.write}</td>
                  <td data-label="Listener, median" class="num">{row.listener}</td>
                  <td data-label="Eight writers" class="num">{row.eight}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note">
        On its own a write commits in under a millisecond; inside the application, with its functions, listeners and web
        server on the same machine, the median was 5.1 ms.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="fair">
    <div class="wrap">
      <div class="facts facts-2 rules">
        <div>
          <h2 id="fair">How it was kept fair</h2>
          <ul>{fairness.map((line) => <li>{line}</li>)}</ul>
        </div>
        <div>
          <h2 id="limits">Its limits</h2>
          <ul>{limits.map((line) => <li>{line}</li>)}</ul>
        </div>
      </div>
      <p class="note">
        The full write-up is in <a href={benchmark.page}>the engine’s docs</a>, and every sample in{' '}
        <a href={benchmark.record}>the record</a>.
      </p>
    </div>
  </section>

  <Closing id="yours" title="Measure your own workload">
    <Fragment slot="lede">
      The application and its data are private, so this run can’t be repeated as it is. Your own tests are the measure that
      matters: run them on both, on the same machine.
    </Fragment>
    <div class="yours">
      <FileFigure name="Terminal" code={yourOwn} kind="session" />
    </div>
    <div class="actions">
      <CopyCommand command={site.install} />
      <a class="button button-primary" href="/docs/get-started/tests">Run your tests on Firenook</a>
    </div>
  </Closing>
</Base>

<style>
  .method {
    margin: 0;
  }

  .method dt {
    color: var(--ink);
    font-size: var(--text-md);
    font-weight: 650;
  }

  .method dd {
    margin: 0;
    color: var(--smoke);
    font-size: var(--text-sm);
  }

  .rules h2 {
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }

  .rules ul {
    display: grid;
    gap: 0.6rem;
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
    color: var(--smoke);
    font-size: var(--text-sm);
  }

  .yours {
    max-width: 40rem;
    margin-top: 1.75rem;
  }
</style>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { page } from '../../lib/pages';
import { graph, organization, website, breadcrumbs } from '../../lib/schema';
import { site } from '../../lib/site';

const meta = page('/blog');
const posts = (await getCollection('blog', (post) => !post.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || a.data.title.localeCompare(b.data.title),
);
const day = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const schema = graph(
  organization,
  website,
  {
    '@type': 'Blog',
    '@id': `${site.url}/blog#blog`,
    name: 'The Firenook blog',
    url: `${site.url}/blog`,
    publisher: { '@id': `${site.url}/#organization` },
    blogPost: posts.map((post) => ({ '@type': 'BlogPosting', headline: post.data.title, url: `${site.url}/blog/${post.id}` })),
  },
  breadcrumbs([
    { name: 'Firenook', path: '/' },
    { name: meta.crumb, path: '/blog' },
  ]),
);
---

<Base title={meta.title} description={meta.description} schema={schema}>
  <link slot="head" rel="alternate" type="application/rss+xml" title="The Firenook blog" href="/blog.xml" />
  <PageHead title="Blog">
    <Fragment slot="lede">How Firenook works, what it measures, and what comes next, from the people building it.</Fragment>
    <Fragment slot="actions">
      <a class="button button-quiet" href="/blog.xml">Follow by RSS</a>
    </Fragment>
  </PageHead>

  <section class="section">
    <div class="wrap">
      <ol class="posts">
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`}>
                <time datetime={post.data.date.toISOString()}>{day.format(post.data.date)}</time>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .posts {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts li + li {
    border-top: 1px solid var(--line);
  }

  .posts a {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    gap: 0.4rem clamp(1.5rem, 4vw, 3rem);
    padding-block: 1.75rem;
    color: inherit;
    text-decoration: none;
  }

  .posts li:first-child a {
    padding-top: 0;
  }

  time {
    grid-row: span 2;
    padding-top: 0.25rem;
    color: var(--ash);
    font-size: var(--text-xs);
  }

  h2 {
    max-width: 30em;
    font-size: var(--text-lg);
    font-weight: 680;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  p {
    max-width: 40em;
    color: var(--smoke);
    font-size: var(--text-sm);
  }

  .posts a:hover h2 {
    color: var(--link);
  }

  @media (max-width: 700px) {
    .posts a {
      grid-template-columns: minmax(0, 1fr);
    }

    time {
      grid-row: auto;
    }
  }
</style>

---
// Measures as panels, each a claim over two rows of blocks on the same scale
// (DESIGN.md): the earlier or official value in grey, the better one lit.
// Lower is better on every measure.

import type { Panel } from '../lib/panels';

interface Props {
  panels: Panel[];
}

const { panels } = Astro.props;

const split = (claim: string) => {
  const [lead, ...rest] = claim.split(' ');
  return { lead, rest: rest.join(' ') };
};
---

<div class="pairs" style={`--columns:${panels.length % 3 === 0 ? 3 : 2}`}>
  {
    panels.map((panel) => {
      const claim = split(panel.claim);
      const [before, after] = panel.rows;
      return (
        <section class="pair" aria-label={`${panel.label}: ${panel.claim}`}>
          <h3>{panel.label}</h3>
          <p class="pair-claim">
            <span class="lit">{claim.lead}</span> {claim.rest}
          </p>
          <dl class="pair-rows">
            <div>
              <dt>{before.href ? <a href={before.href}>{before.who}</a> : before.who}</dt>
              <dd>
                <span class="pair-track">
                  <span class="cells" style={`--share:${before.share}`} />
                </span>
                <span class="pair-value">{before.text}</span>
              </dd>
            </div>
            <div>
              <dt>{after.href ? <a href={after.href}>{after.who}</a> : after.who}</dt>
              <dd>
                <span class="pair-track cells-glow">
                  <span class="cells cells-lit" style={`--share:${after.share}`} />
                </span>
                <span class="pair-value pair-value-lit">{after.text}</span>
              </dd>
            </div>
          </dl>
        </section>
      );
    })
  }
</div>

<style>
  .pairs {
    display: grid;
    grid-template-columns: repeat(var(--columns, 3), minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .pair {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    min-width: 0;
    padding: 1.6rem 1.6rem 1.75rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .pair h3 {
    color: var(--smoke);
    font-size: var(--text-sm);
    font-weight: 560;
    letter-spacing: -0.005em;
  }

  .pair-claim {
    margin-bottom: 1.1rem;
    color: var(--ink);
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .pair-claim .lit {
    font-size: var(--text-num);
    font-weight: 780;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .pair-rows {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .pair-rows div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'who value' 'track track';
    align-items: center;
    row-gap: 0.4rem;
  }

  .pair-rows dt {
    grid-area: who;
    color: var(--ash);
    font-size: var(--text-xs);
  }

  .pair-rows dt a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .pair-rows dt a:hover {
    color: var(--ink);
  }

  .pair-rows dd {
    display: contents;
  }

  .pair-track {
    grid-area: track;
    display: block;
    min-width: 0;
    --cell-height: 12px;
  }

  .pair-value {
    grid-area: value;
    color: var(--smoke);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .pair-value-lit {
    color: var(--ink);
    font-weight: 650;
  }

  @media (max-width: 1000px) {
    .pairs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .pairs {
      grid-template-columns: minmax(0, 1fr);
    }

    .pair {
      padding: 1.35rem 1.25rem 1.5rem;
    }
  }
</style>

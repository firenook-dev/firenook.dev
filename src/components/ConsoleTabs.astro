---
// The console, a tab a page. Pictures are the console itself, in dark.
import { Image } from 'astro:assets';
import overview from '../assets/console/overview-dark.png';
import invocations from '../assets/console/invocations-dark.png';
import auth from '../assets/console/auth-dark.png';
import firestore from '../assets/console/firestore-dark.png';
import storage from '../assets/console/storage-dark.png';

const tabs = [
  {
    id: 'invocations',
    label: 'Function calls',
    image: invocations,
    alt: 'The console’s function calls: every call with its time, function, trigger, summary, outcome and duration, one of them a 500',
    text: 'Every call, with what triggered it, its outcome, its duration and its logs. The official UI has only the log.',
  },
  {
    id: 'overview',
    label: 'Overview',
    image: overview,
    alt: 'The console’s Overview: all nine services running, with their ports and counts',
    text: 'Every service’s health and recent problems, with snapshots and resets a click away.',
  },
  {
    id: 'auth',
    label: 'Authentication',
    image: auth,
    alt: 'Authentication: a list of users with filters, one open with its profile, security and providers',
    text: 'Users and their activity, and an inbox of the codes and links Auth would have sent.',
  },
  {
    id: 'firestore',
    label: 'Firestore',
    image: firestore,
    alt: 'Firestore: collections, a page of orders and one order open for editing',
    text: 'Browse and edit documents, and read the rules that guard them.',
  },
  {
    id: 'storage',
    label: 'Storage',
    image: storage,
    alt: 'Storage: a folder of product photos shown as a grid of thumbnails',
    text: 'Browse and upload files, and read the rules that guard them.',
  },
];
---

<div class="console-tabs" data-tabs>
  <div class="console-controls">
    <div class="console-tablist" role="tablist" aria-label="Console pages">
      {
        tabs.map((tab, index) => (
          <button
            type="button"
            role="tab"
            id={`console-tab-${tab.id}`}
            aria-controls={`console-panel-${tab.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
          >
            {tab.label}
          </button>
        ))
      }
    </div>
    <p class="console-caption" aria-hidden="true">{tabs[0].text}</p>
  </div>
  <div class="console-stage">
    {
      tabs.map((tab, index) => (
        <div
          class="console-panel"
          role="tabpanel"
          id={`console-panel-${tab.id}`}
          aria-labelledby={`console-tab-${tab.id}`}
          hidden={index !== 0}
        >
          <p class="console-panel-text">{tab.text}</p>
          <div class="console-frame">
            <Image
              src={tab.image}
              alt={tab.alt}
              widths={[640, 960, 1280, 1600, 2400]}
              sizes="(min-width: 75rem) 75rem, 100vw"
              loading="lazy"
              quality={84}
            />
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const caption = root.querySelector('.console-caption');
    const select = (next: HTMLButtonElement, focus: boolean) => {
      for (const tab of tabs) {
        const on = tab === next;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
        if (on && caption) caption.textContent = panel?.querySelector('.console-panel-text')?.textContent ?? '';
      }
      if (focus) next.focus();
    };
    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener('click', () => select(tab, false));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 0;
        if (step) event.preventDefault();
        if (step) select(tabs[(index + step + tabs.length) % tabs.length], true);
        if (event.key === 'Home') select(tabs[0], true);
        if (event.key === 'End') select(tabs[tabs.length - 1], true);
      });
    }
  }
</script>

<style>
  /* The pages, and what the selected one shows, on one row. */
  .console-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.25rem;
  }

  .console-caption {
    flex: 1 1 18rem;
    max-width: 36em;
    color: var(--smoke);
    font-size: var(--text-sm);
  }

  /* One control: the pages as segments, where you are lit by the flame. */
  .console-tablist {
    display: inline-flex;
    gap: 0.2rem;
    max-width: 100%;
    overflow-x: auto;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--cinder);
    scrollbar-width: none;
  }

  [role='tab'] {
    flex: none;
    padding: 0.5rem 1rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--smoke);
    font: 560 var(--text-sm) / 1.2 var(--font);
    cursor: pointer;
    transition:
      background-color 140ms ease,
      color 140ms ease;
  }

  [role='tab']:hover {
    color: var(--ink);
  }

  [role='tab'][aria-selected='true'] {
    border-color: rgb(242 56 24 / 0.55);
    background: var(--hearth-2);
    color: var(--ink);
  }

  .console-panel {
    display: grid;
    gap: 1rem;
  }

  /* A display of its own would override the hidden attribute: only the
     selected page shows. */
  .console-panel[hidden] {
    display: none;
  }

  /* Each page keeps its words for screen readers and pages without
     JavaScript; the row above shows them to everyone else. */
  .console-panel-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .console-stage {
    position: relative;
    isolation: isolate;
  }

  .console-stage::before {
    content: '';
    position: absolute;
    inset: 20% 10% -5% 10%;
    z-index: -1;
    background: radial-gradient(50% 50% at 50% 100%, rgb(242 56 24 / 0.2), transparent 70%);
    filter: blur(40px);
  }

  .console-frame {
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.13);
    border-radius: 14px;
    background: #000;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.6),
      0 40px 90px -35px rgb(0 0 0 / 0.95);
  }

  .console-frame img {
    width: 100%;
  }

  @media (max-width: 640px) {
    .console-tablist {
      margin-inline: calc(-1 * var(--gutter));
      max-width: none;
      border-radius: 0;
      border-inline: 0;
      padding-inline: var(--gutter);
    }

    .console-caption {
      min-height: 3em;
    }
  }

  /* Without JavaScript the pages show one after another. */
  :global(html:not(.js)) .console-controls {
    display: none;
  }

  :global(html:not(.js)) .console-panel[hidden] {
    display: grid;
    margin-top: 2.5rem;
  }

  :global(html:not(.js)) .console-panel-text {
    position: static;
    width: auto;
    height: auto;
    clip: auto;
    white-space: normal;
    color: var(--smoke);
  }
</style>

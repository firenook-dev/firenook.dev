---
// The console, a tab a page. Pictures are the console itself, in dark.
import { Image } from 'astro:assets';
import overview from '../assets/console/overview-dark.png';
import invocations from '../assets/console/invocations-dark.png';
import auth from '../assets/console/auth-dark.png';
import firestore from '../assets/console/firestore-dark.png';
import storage from '../assets/console/storage-dark.png';

const tabs = [
  {
    id: 'invocations',
    label: 'Function calls',
    image: invocations,
    alt: 'The console’s function calls: every call with its time, function, trigger, summary, outcome and duration, one of them a 500',
    text: 'Every call, with what triggered it, its outcome, its duration and its logs. The official UI has only the log.',
  },
  {
    id: 'overview',
    label: 'Overview',
    image: overview,
    alt: 'The console’s Overview: all nine services running, with their ports and counts',
    text: 'Every service’s health and recent problems, with snapshots and resets a click away.',
  },
  {
    id: 'auth',
    label: 'Authentication',
    image: auth,
    alt: 'Authentication: a list of users with filters, one open with its profile, security and providers',
    text: 'Users and their activity, and an inbox of the codes and links Auth would have sent.',
  },
  {
    id: 'firestore',
    label: 'Firestore',
    image: firestore,
    alt: 'Firestore: collections, a page of orders and one order open for editing',
    text: 'Browse and edit documents, and read the rules that guard them.',
  },
  {
    id: 'storage',
    label: 'Storage',
    image: storage,
    alt: 'Storage: a folder of product photos shown as a grid of thumbnails',
    text: 'Browse and upload files, and read the rules that guard them.',
  },
];
---

<div class="console-tabs" data-tabs>
  <div class="console-tablist" role="tablist" aria-label="Console pages" aria-orientation="vertical">
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`console-tab-${tab.id}`}
          aria-controls={`console-panel-${tab.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
        >
          <span class="tab-label">{tab.label}</span>
          <span class="tab-text">{tab.text}</span>
        </button>
      ))
    }
  </div>
  <div class="console-stage">
    {
      tabs.map((tab, index) => (
        <div
          class="console-panel"
          role="tabpanel"
          id={`console-panel-${tab.id}`}
          aria-labelledby={`console-tab-${tab.id}`}
          hidden={index !== 0}
        >
          <p class="console-panel-text">{tab.text}</p>
          <div class="console-frame">
            <Image
              src={tab.image}
              alt={tab.alt}
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 75rem) 52rem, 100vw"
              loading="lazy"
              quality={84}
            />
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (next: HTMLButtonElement, focus: boolean) => {
      for (const tab of tabs) {
        const on = tab === next;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      }
      if (focus) next.focus();
    };
    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener('click', () => select(tab, false));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 0;
        if (step) event.preventDefault();
        if (step) select(tabs[(index + step + tabs.length) % tabs.length], true);
        if (event.key === 'Home') select(tabs[0], true);
        if (event.key === 'End') select(tabs[tabs.length - 1], true);
      });
    }
  }
</script>

<style>
  .console-tabs {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .console-tablist {
    display: grid;
    gap: 0.25rem;
  }

  [role='tab'] {
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 1rem 0.95rem 1.15rem;
    border: 1px solid transparent;
    border-radius: 12px;
    background: transparent;
    color: var(--smoke);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 140ms ease,
      border-color 140ms ease;
  }

  [role='tab']:hover {
    background: rgb(255 255 255 / 0.03);
  }

  .tab-label {
    color: var(--ink);
    font-size: 1.02rem;
    font-weight: 620;
  }

  .tab-text {
    font-size: 0.92rem;
    line-height: 1.45;
  }

  /* Where you are: the flame, as in the console. */
  [role='tab'][aria-selected='true'] {
    border-color: var(--line);
    background: linear-gradient(180deg, #1c1c20, #18181b);
  }

  [role='tab'][aria-selected='true']::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 2px;
    border-radius: 2px;
    background: var(--flame);
  }

  .console-stage {
    position: relative;
    isolation: isolate;
  }

  .console-stage::before {
    content: '';
    position: absolute;
    inset: 12% 8% -6% 8%;
    z-index: -1;
    background: radial-gradient(50% 50% at 50% 100%, rgb(242 56 24 / 0.22), transparent 70%);
    filter: blur(40px);
  }

  .console-panel-text {
    display: none;
  }

  .console-frame {
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.13);
    border-radius: 14px;
    background: #000;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.6),
      0 40px 90px -35px rgb(0 0 0 / 0.95);
  }

  .console-frame img {
    width: 100%;
  }

  @media (max-width: 960px) {
    .console-tabs {
      grid-template-columns: minmax(0, 1fr);
    }

    .console-tablist {
      display: flex;
      gap: 0.35rem;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    [role='tab'] {
      flex: none;
      padding: 0.5rem 0.95rem;
      border-color: var(--line);
      border-radius: 999px;
    }

    [role='tab'][aria-selected='true'] {
      border-color: rgb(242 56 24 / 0.7);
    }

    [role='tab'][aria-selected='true']::before,
    .tab-text {
      display: none;
    }

    .tab-label {
      font-size: 0.95rem;
      font-weight: 560;
    }

    .console-panel-text {
      display: block;
      min-height: 3em;
      margin-bottom: 1rem;
      color: var(--smoke);
    }
  }

  /* Without JavaScript the pages show one after another. */
  :global(html:not(.js)) .console-tablist {
    display: none;
  }

  :global(html:not(.js)) .console-tabs {
    grid-template-columns: minmax(0, 1fr);
  }

  :global(html:not(.js)) .console-panel[hidden] {
    display: block;
    margin-top: 2.5rem;
  }

  :global(html:not(.js)) .console-panel-text {
    display: block;
    margin-bottom: 1rem;
    color: var(--smoke);
  }
</style>

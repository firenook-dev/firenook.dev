---
// Firenook beside the official emulator, one measure a panel (Pairs.astro).
import Pairs from './Pairs.astro';
import { pairs as all } from '../lib/benchmarks';
import type { Panel } from '../lib/panels';

interface Props {
  /** The measures to show, by label; all six by default. */
  only?: string[];
}

const { only } = Astro.props;
const pairs = only ? all.filter((pair) => only.includes(pair.label)) : all;
const panels: Panel[] = pairs.map((pair) => ({
  label: pair.label,
  claim: pair.claim,
  rows: [
    { who: 'Official', text: pair.text[0], share: 1 },
    { who: 'Firenook', text: pair.text[1], share: pair.firenook / pair.official },
  ],
}));
---

<Pairs panels={panels} />

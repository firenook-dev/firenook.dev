---
// A command to run, with a button that copies it.
interface Props {
  command: string;
  /** Shown before the command, not copied. */
  prompt?: string;
  /** Wrap a long command onto more lines instead of scrolling it. */
  wrap?: boolean;
}
const { command, prompt = '$', wrap = false } = Astro.props;
---

<div class:list={['copy-command', { 'copy-command-wrap': wrap }]}>
  {
    wrap ? (
      // Wrapped, a command breaks only between its words, never inside a flag.
      <code>
        <span class="copy-command-prompt" aria-hidden="true">{prompt}</span>
        {command.split(' ').map((word, index) => (index ? <><span> </span><span class="copy-command-word">{word}</span></> : <span class="copy-command-word">{word}</span>))}
      </code>
    ) : (
      <code><span class="copy-command-prompt" aria-hidden="true">{prompt}</span>{command}</code>
    )
  }
  <button type="button" class="copy-command-button" data-copy={command} aria-label={`Copy: ${command}`}>
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.4"></rect><path d="M11 5V3.6A1.6 1.6 0 0 0 9.4 2H3.6A1.6 1.6 0 0 0 2 3.6v5.8A1.6 1.6 0 0 0 3.6 11H5" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
    <span class="copy-command-done" aria-live="polite"></span>
  </button>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-command-button')) {
    const done = button.querySelector('.copy-command-done');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        if (done) done.textContent = 'Copied';
      } catch {
        if (done) done.textContent = 'Select the command to copy it';
      }
      setTimeout(() => {
        if (done) done.textContent = '';
      }, 1800);
    });
  }
</script>

<style>
  /* A raised control, lit along its top edge like the buttons beside it. */
  .copy-command {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 100%;
    min-height: 2.9rem;
    padding: 0.3rem 0.3rem 0.3rem 1.15rem;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 999px;
    background: linear-gradient(180deg, #27272d, #1d1d22);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.1),
      0 12px 26px -16px rgb(0 0 0 / 0.9);
    transition: border-color 120ms ease;
  }

  .copy-command:hover,
  .copy-command:focus-within {
    border-color: rgb(255 255 255 / 0.26);
  }

  .copy-command code {
    min-width: 0;
    overflow-x: auto;
    padding: 0;
    background: none;
    color: var(--ink);
    font-size: var(--text-sm);
    white-space: nowrap;
    scrollbar-width: none;
  }

  /* On a phone the install command fits whole: the face follows the screen's
     width, never below 12 px; a longer command still scrolls. */
  @media (max-width: 480px) {
    .copy-command {
      gap: 0.45rem;
      padding-left: 0.9rem;
    }

    .copy-command code {
      font-size: clamp(0.75rem, 3.4vw, var(--text-sm));
    }
  }

  .copy-command-wrap {
    align-items: start;
    padding: 0.6rem 0.4rem 0.6rem 0.9rem;
    border-radius: 12px;
  }

  .copy-command-wrap code {
    flex: 1;
    overflow: visible;
    padding-top: 0.32rem;
    line-height: 1.5;
    white-space: normal;
  }

  .copy-command-word {
    white-space: nowrap;
  }

  .copy-command-prompt {
    margin-right: 0.6ch;
    color: var(--link);
    user-select: none;
  }

  .copy-command-button {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.07);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 120ms ease;
  }

  .copy-command-button:hover {
    background: rgb(255 255 255 / 0.14);
  }

  .copy-command-done {
    position: absolute;
  }

  .copy-command-done:not(:empty) {
    bottom: calc(100% + 0.4rem);
    right: 0;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-small);
    background: var(--ink);
    color: var(--night);
    font: 600 var(--text-xs) / 1.2 var(--font);
    white-space: nowrap;
  }

  :global(html:not(.js)) .copy-command-button {
    display: none;
  }
</style>

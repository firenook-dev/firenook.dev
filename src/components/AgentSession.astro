---
// An agent working on the demo project through `firenook mcp`: the question
// is an example; every tool call and every answer is from the run kept by
// scripts/capture/, as Firenook gave it.
import Pixels from './Pixels.astro';
import { call, clock, demoRun, functionName } from '../lib/demo-run';

const failed = call('functions_list_calls', { outcome: 'failed' });
const first = failed.result.calls[0];
const detail = call('functions_get_call').result;
const frame = String(detail.stack).split('\n')[1]?.trim() ?? '';
const headers = Object.keys(detail.request.headers);
const rules = call('rules_evaluate').result;
const decided = rules.decidedBy[0];
const args = (input: Record<string, unknown>) =>
  Object.entries(input)
    .map(([key, value]) => `${key}: ${JSON.stringify(value)}`)
    .join(', ');
---

<figure class="agent">
  <div class="agent-bar" aria-hidden="true">
    <span><Pixels art="flame" size={12} />firenook mcp</span>
    <span>demo-shop</span>
  </div>
  <ol class="agent-log">
    <li class="agent-ask">
      <span class="agent-who">You</span>
      <p>The Stripe webhook answers 500 on my machine. Why?</p>
    </li>
    <li class="agent-tool">
      <p class="agent-call"><b>functions_list_calls</b> <span>{args(failed.args)}</span></p>
      <div class="agent-answer">
        <dl>
          <div><dt>{first.outcome}</dt><dd><span class="bad">{first.status}</span>{' '}{functionName(first.function)}{' '}<span class="dim">{first.kind} {first.summary}, {first.durationMs} ms at {clock(first.startedAt)}</span></dd></div>
        </dl>
      </div>
    </li>
    <li class="agent-tool">
      <p class="agent-call"><b>functions_get_call</b> <span>{args(call('functions_get_call').args)}</span></p>
      <div class="agent-answer">
        <dl>
          <div><dt>error</dt><dd class="bad">{detail.error.replace(/^Unhandled error /, '')}</dd></div>
          <div><dt>at</dt><dd>{frame.replace(/^at /, '')}</dd></div>
          <div><dt>headers</dt><dd><span class="dim">{headers.join(', ')}</span></dd></div>
          <div><dt>body</dt><dd>{JSON.stringify(detail.request.body)}</dd></div>
        </dl>
      </div>
    </li>
    <li class="agent-tool">
      <p class="agent-call"><b>rules_evaluate</b> <span>{args(call('rules_evaluate').args)}</span></p>
      <div class="agent-answer">
        <dl>
          <div><dt>verdict</dt><dd><span class="bad">{rules.outcome}</span> <span class="dim">as {rules.as}</span></dd></div>
          <div><dt>line {decided.line}</dt><dd>{decided.text}</dd></div>
        </dl>
      </div>
    </li>
  </ol>
  <figcaption>
    The question is an example. The tool calls and their answers are from a run of the demo project on firenook {demoRun.version},
    as Firenook gave them.
  </figcaption>
</figure>

<style>
  .agent {
    margin: 0;
  }

  .agent-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-bottom: 1px solid var(--line);
    border-radius: 14px 14px 0 0;
    background: #141417;
    color: var(--smoke);
    font: 560 0.82rem / 1.2 var(--font);
  }

  .agent-bar span {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .agent-bar span + span {
    color: var(--ash);
    font-weight: 400;
  }

  .agent-log {
    display: grid;
    gap: 1.1rem;
    margin: 0;
    padding: 1.25rem 1.2rem 1.4rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-top: 0;
    border-radius: 0 0 14px 14px;
    background: var(--cinder);
    box-shadow: 0 40px 90px -40px rgb(0 0 0 / 0.95);
    list-style: none;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .agent-ask {
    display: grid;
    gap: 0.3rem;
    padding: 0.8rem 0.95rem;
    border-radius: 10px;
    background: var(--hearth-2);
    font-family: var(--font);
  }

  .agent-who {
    color: var(--ash);
    font-size: 0.78rem;
    font-weight: 560;
  }

  .agent-ask p {
    color: var(--ink);
    font-size: 0.97rem;
  }

  .agent-tool {
    display: grid;
    gap: 0.45rem;
  }

  .agent-call {
    color: var(--smoke);
  }

  .agent-call::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.6rem;
    background: var(--amber);
    box-shadow: 0 0 8px rgb(255 152 0 / 0.7);
    vertical-align: 0.1em;
  }

  .agent-call b {
    color: var(--ink);
    font-weight: 600;
  }

  .agent-call span {
    color: var(--ash);
  }

  .agent-answer {
    margin-left: 0.2rem;
    padding: 0.15rem 0 0.15rem 1rem;
    border-left: 1px solid var(--line-strong);
    color: var(--ink);
  }

  .agent-answer dl {
    display: grid;
    gap: 0.2rem;
    margin: 0;
  }

  .agent-answer dl div {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.75rem;
  }

  .agent-answer dt {
    color: var(--ash);
  }

  .agent-answer dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .bad {
    color: var(--term-red);
  }

  .dim {
    color: var(--smoke);
  }

  figcaption {
    margin-top: 0.9rem;
    color: var(--ash);
    font-size: var(--step--1);
  }
</style>

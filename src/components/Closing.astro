---
// The end of a page: the flame, once more, over a bed of embers, and the way
// in. The heading and its sentence come first; what the page offers to do
// next (steps, a command, buttons) follows in the slot.
import Pixels from './Pixels.astro';
import Embers from './Embers.astro';

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section class="closing" aria-labelledby={id}>
  <div class="wrap">
    <div class="closing-head">
      <div class="closing-flame cells-glow">
        <Pixels art="flame" size={100} />
      </div>
      <div class="head">
        <h2 id={id}>{title}</h2>
        <p class="lede"><slot name="lede" /></p>
      </div>
    </div>
    <slot />
  </div>
  <Embers class="closing-embers" columns={110} rows={14} seed={23} />
</section>

<style>
  .closing {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3.5rem, 6vw, 5.25rem);
    border-top: 1px solid var(--line);
    padding-bottom: clamp(8rem, 13vw, 11rem);
    isolation: isolate;
  }

  .closing-head {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .closing-flame {
    position: relative;
    flex: none;
  }

  .closing-flame::before {
    content: '';
    position: absolute;
    inset: -45%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(242 56 24 / 0.32), rgb(255 152 0 / 0.1) 55%, transparent);
    filter: blur(22px);
  }

  .closing :global(.actions) {
    margin-top: 1.75rem;
  }

  .closing :global(.closing-embers) {
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: 0;
    height: clamp(6rem, 12vw, 9.5rem);
    z-index: -1;
    -webkit-mask: linear-gradient(to bottom, transparent, #000 55%);
    mask: linear-gradient(to bottom, transparent, #000 55%);
  }

  @media (max-width: 560px) {
    .closing-head {
      flex-direction: column;
      align-items: start;
    }

    .closing-flame :global(.pixels) {
      width: 70px;
      height: 70px;
    }
  }
</style>

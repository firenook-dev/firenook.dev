---
import logo from '../assets/brand/firenook-logo-flat-on-dark.svg';
import { site } from '../lib/site';

const links = [
  { href: '/docs', label: 'Docs' },
  { href: '/benchmarks', label: 'Benchmarks' },
  { href: '/compatibility', label: 'Compatibility' },
  { href: '/mcp', label: 'MCP' },
  { href: '/blog', label: 'Blog' },
];
const here = Astro.url.pathname.replace(/\.html$/, '');
const current = (href: string) => here === href || here.startsWith(`${href}/`);
---

<header class="nav">
  <div class="wrap nav-row">
    <a class="nav-home" href="/" aria-label="Firenook home">
      <img src={logo.src} width="110" height="36" alt="Firenook" />
    </a>
    <nav class="nav-links" aria-label="Site">
      {links.map((link) => <a href={link.href} aria-current={current(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <div class="nav-end">
      <a class="nav-github" href={site.repo}>
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
        <span>GitHub</span>
      </a>
      <a class="button button-primary nav-start" href="/docs/get-started/install">Get started</a>
      <details class="nav-menu">
        <summary aria-label="Menu">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
        </summary>
        <nav class="nav-sheet" aria-label="Site">
          {links.map((link) => <a href={link.href} aria-current={current(link.href) ? 'page' : undefined}>{link.label}</a>)}
          <a href={site.repo}>GitHub</a>
          <a class="button button-primary" href="/docs/get-started/install">Get started</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    background: rgb(20 20 22 / 0.82);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }

  .nav-row {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4rem;
  }

  .nav-home img {
    width: auto;
    height: 1.75rem;
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
  }

  .nav-links a,
  .nav-github {
    position: relative;
    padding: 0.45rem 0.7rem;
    border-radius: var(--radius-small);
    color: var(--smoke);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }

  .nav-links a:hover,
  .nav-github:hover {
    color: var(--ink);
  }

  /* Where you are: the flame, as in the console. */
  .nav-links a[aria-current='page'] {
    color: var(--ink);
  }

  .nav-links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: -0.78rem;
    height: 2px;
    border-radius: 2px;
    background: var(--flame);
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .nav-github {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .nav-start {
    min-height: 2.35rem;
    padding: 0.45rem 1rem;
    font-size: 0.95rem;
  }

  .nav-menu {
    display: none;
    position: relative;
  }

  .nav-menu summary {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    list-style: none;
    cursor: pointer;
  }

  .nav-menu summary::-webkit-details-marker {
    display: none;
  }

  .nav-sheet {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    display: grid;
    gap: 0.15rem;
    width: min(17rem, calc(100vw - 2.5rem));
    padding: 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--hearth);
    box-shadow: 0 24px 48px -12px rgb(0 0 0 / 0.6);
  }

  .nav-sheet a:not(.button) {
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-small);
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }

  .nav-sheet a:not(.button):hover {
    background: rgb(255 255 255 / 0.05);
  }

  .nav-sheet a[aria-current='page'] {
    box-shadow: inset 2px 0 0 var(--flame);
  }

  .nav-sheet .button {
    margin-top: 0.4rem;
  }

  @media (max-width: 860px) {
    .nav-links,
    .nav-github,
    .nav-start {
      display: none;
    }

    .nav-menu {
      display: block;
    }
  }
</style>

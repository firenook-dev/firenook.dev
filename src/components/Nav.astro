---
import logo from '../assets/brand/firenook-logo-on-dark.svg';
import Pixels from './Pixels.astro';
import { site, services } from '../lib/site';

const top = [
  { href: '/docs', label: 'Docs' },
  { href: '/benchmarks', label: 'Benchmarks' },
  { href: '/blog', label: 'Blog' },
];
const tools = [
  { href: '/console', label: 'The console', text: 'Every service, live, on the Emulator UI’s port' },
  { href: '/mcp', label: 'MCP for agents', text: '54 tools over the running emulators' },
  { href: '/benchmarks', label: 'Benchmarks', text: 'Measured on a real application' },
  { href: '/compatibility', label: 'Compatibility', text: 'What each service covers, and what it does not' },
  { href: '/vs/firebase-emulator-suite', label: 'Compared with the official suite', text: 'Side by side, with the sources' },
];
const here = Astro.url.pathname.replace(/\.html$/, '');
const current = (href: string) => here === href || here.startsWith(`${href}/`);
const inProduct = tools.some((tool) => current(tool.href)) || services.some((service) => current(service.href));
---

<header class="nav">
  <div class="wrap nav-row">
    <a class="nav-home" href="/" aria-label="Firenook home">
      <img src={logo.src} width="121" height="40" alt="Firenook" />
    </a>
    <nav class="nav-links" aria-label="Site">
      <div class="nav-product" data-menu>
        <button type="button" class="nav-trigger" aria-expanded="false" aria-controls="nav-product-panel" aria-current={inProduct ? 'page' : undefined}>
          Product
          <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M3 4.5 6 7.5l3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <div class="nav-panel" id="nav-product-panel">
          <div class="nav-panel-services">
            <p class="nav-panel-heading">The emulators, on their usual ports</p>
            <ul>
              {
                services.map((service) => (
                  <li>
                    <a href={service.href} aria-current={current(service.href) ? 'page' : undefined}>
                      <Pixels art={service.art} size={20} gap={0} />
                      <span>{service.name}</span>
                      <code>{service.port}</code>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="nav-panel-tools">
            <p class="nav-panel-heading">Around them</p>
            <ul>
              {
                tools.map((tool) => (
                  <li>
                    <a href={tool.href} aria-current={current(tool.href) ? 'page' : undefined}>
                      <span>{tool.label}</span>
                      <small>{tool.text}</small>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
      {top.map((link) => <a class="nav-link" href={link.href} aria-current={current(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <div class="nav-end">
      <a class="nav-github" href={site.repo} aria-label="Firenook on GitHub">
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
      </a>
      <a class="button button-primary nav-start" href="/docs/get-started/install">Get started</a>
      <details class="nav-menu">
        <summary aria-label="Menu">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
        </summary>
        <nav class="nav-sheet" aria-label="Site">
          <p class="nav-panel-heading">The emulators</p>
          <ul class="nav-sheet-services">
            {
              services.map((service) => (
                <li>
                  <a href={service.href} aria-current={current(service.href) ? 'page' : undefined}>
                    <Pixels art={service.art} size={20} gap={0} />
                    {service.name}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="nav-panel-heading">Around them</p>
          <ul>
            {tools.map((tool) => <li><a href={tool.href} aria-current={current(tool.href) ? 'page' : undefined}>{tool.label}</a></li>)}
            <li><a href="/docs" aria-current={current('/docs') ? 'page' : undefined}>Docs</a></li>
            <li><a href="/blog" aria-current={current('/blog') ? 'page' : undefined}>Blog</a></li>
            <li><a href={site.repo}>GitHub</a></li>
          </ul>
          <a class="button button-primary" href="/docs/get-started/install">Get started</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // The Product menu opens on a click (and on hover with a mouse), and closes
  // on Escape, on a click elsewhere, or when the pointer leaves it.
  for (const menu of document.querySelectorAll<HTMLElement>('[data-menu]')) {
    const trigger = menu.querySelector<HTMLButtonElement>('.nav-trigger');
    if (!trigger) continue;
    let timer: number | undefined;
    const set = (open: boolean) => {
      menu.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', String(open));
    };
    trigger.addEventListener('click', () => set(!menu.classList.contains('is-open')));
    const hover = matchMedia('(hover: hover) and (pointer: fine)');
    menu.addEventListener('pointerenter', () => {
      if (!hover.matches) return;
      clearTimeout(timer);
      set(true);
    });
    menu.addEventListener('pointerleave', () => {
      if (!hover.matches) return;
      timer = window.setTimeout(() => set(false), 160);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.classList.contains('is-open')) {
        set(false);
        trigger.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) set(false);
    });
    menu.addEventListener('focusout', (event) => {
      if (!menu.contains(event.relatedTarget as Node | null)) set(false);
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgb(20 20 22 / 0.94);
    backdrop-filter: saturate(1.5) blur(16px);
    -webkit-backdrop-filter: saturate(1.5) blur(16px);
  }

  .nav-row {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    height: 4rem;
  }

  .nav-home {
    flex: none;
    border-radius: var(--radius-small);
  }

  .nav-home img {
    width: auto;
    height: 1.75rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .nav-link,
  .nav-trigger,
  .nav-github {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.75rem;
    border: 0;
    border-radius: var(--radius-small);
    background: none;
    color: var(--smoke);
    font: 520 var(--text-sm) / 1.2 var(--font);
    text-decoration: none;
    cursor: pointer;
  }

  .nav-link:hover,
  .nav-trigger:hover,
  .nav-github:hover,
  .nav-product.is-open .nav-trigger {
    color: var(--ink);
  }

  .nav-trigger svg {
    transition: transform 160ms ease;
  }

  .nav-product.is-open .nav-trigger svg {
    transform: rotate(180deg);
  }

  /* Where you are: the flame, as in the console. */
  .nav-link[aria-current='page'],
  .nav-trigger[aria-current='page'] {
    color: var(--ink);
  }

  .nav-link[aria-current='page']::after,
  .nav-trigger[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: -0.78rem;
    height: 2px;
    border-radius: 2px;
    background: var(--flame);
  }

  .nav-product {
    position: relative;
  }

  .nav-panel {
    position: absolute;
    left: -1.25rem;
    top: calc(100% + 0.85rem);
    display: none;
    grid-template-columns: 17rem 21rem;
    gap: 0.5rem;
    padding: 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background: #1a1a1e;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.05) inset,
      0 30px 60px -20px rgb(0 0 0 / 0.75);
  }

  /* The gap between the trigger and the panel still counts as the menu. */
  .nav-panel::before {
    content: '';
    position: absolute;
    inset: -1rem 0 100% 0;
  }

  .nav-product.is-open .nav-panel,
  :global(html:not(.js)) .nav-product:hover .nav-panel,
  :global(html:not(.js)) .nav-product:focus-within .nav-panel {
    display: grid;
  }

  .nav-panel-heading {
    padding: 0.6rem 0.75rem 0.35rem;
    color: var(--ash);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .nav-panel ul,
  .nav-sheet ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-panel-services {
    padding-right: 0.5rem;
    border-right: 1px solid var(--line);
  }

  .nav-panel-services a {
    display: grid;
    grid-template-columns: 20px 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-small);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 540;
    text-decoration: none;
  }

  .nav-panel-services :global(.pixels) {
    color: var(--smoke);
  }

  .nav-panel-services code {
    padding: 0;
    background: none;
    color: var(--ash);
    font-size: var(--text-xs);
  }

  .nav-panel-tools a {
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-small);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 560;
    text-decoration: none;
  }

  .nav-panel-tools small {
    color: var(--smoke);
    font-size: var(--text-xs);
    font-weight: 400;
  }

  .nav-panel a:hover,
  .nav-panel a:focus-visible {
    background: rgb(255 255 255 / 0.05);
  }

  .nav-panel a:hover :global(.pixels) {
    color: var(--ink);
  }

  .nav-panel a[aria-current='page'],
  .nav-sheet a[aria-current='page'] {
    box-shadow: inset 2px 0 0 var(--flame);
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }

  .nav-github {
    padding: 0.5rem;
  }

  .nav-start {
    min-height: 2.4rem;
    padding: 0.45rem 1.05rem;
    font-size: var(--text-sm);
  }

  .nav-menu {
    display: none;
    position: relative;
  }

  .nav-menu summary {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    list-style: none;
    cursor: pointer;
  }

  .nav-menu summary::-webkit-details-marker {
    display: none;
  }

  .nav-sheet {
    position: absolute;
    right: 0;
    top: calc(100% + 0.7rem);
    display: grid;
    width: min(20rem, calc(100vw - 2.5rem));
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    padding: 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background: #1a1a1e;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.75);
  }

  .nav-sheet-services {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-bottom: 0.25rem !important;
  }

  .nav-sheet a:not(.button) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-small);
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 540;
    text-decoration: none;
  }

  .nav-sheet :global(.pixels) {
    flex: none;
    color: var(--smoke);
  }

  .nav-sheet a:not(.button):hover {
    background: rgb(255 255 255 / 0.05);
  }

  .nav-sheet .button {
    margin: 0.5rem 0.25rem 0.25rem;
  }

  @media (max-width: 900px) {
    .nav-links,
    .nav-github,
    .nav-start {
      display: none;
    }

    .nav-menu {
      display: block;
    }
  }
</style>

---
// A bed of lit blocks, hottest at the bottom middle: the fire the terminal
// sits on (DESIGN.md). Drawn once at build time from a fixed seed, so every
// build draws the same embers.
import { flameAt, paths, seeded } from '../lib/pixels';

interface Props {
  columns?: number;
  rows?: number;
  seed?: number;
  class?: string;
}

const { columns = 96, rows = 22, seed = 7, class: className } = Astro.props;
const random = seeded(seed);
const cells: { x: number; y: number; fill: string; opacity: number }[] = [];
const middle = (columns - 1) / 2;
for (let y = 0; y < rows; y++) {
  for (let x = 0; x < columns; x++) {
    const across = (x - middle) / middle;
    const up = (rows - 1 - y) / (rows - 1);
    const heat = Math.exp(-across * across * 2.2) * Math.pow(1 - up, 1.7);
    if (random() > heat * 0.62) continue;
    const glow = Math.min(1, heat * (0.55 + random() * 0.7));
    cells.push({
      x,
      y,
      // Amber where it is hottest, flame at the edges and the top.
      fill: flameAt(Math.round(Math.min(1, Math.max(0, glow * 1.15 - 0.1 + (random() - 0.5) * 0.3)) * 6) / 6),
      opacity: Math.round((0.18 + glow * 0.82) * 8) / 8,
    });
  }
}
const cell = 0.8;
const offset = (1 - cell) / 2;
const blurred = paths(cells, 1);
const lit = paths(cells, cell, offset);
---

<div class:list={['embers', className]} aria-hidden="true">
  <svg class="embers-glow" viewBox={`0 0 ${columns} ${rows}`} preserveAspectRatio="none">
    {blurred.map((group) => <path d={group.d} fill={group.fill} fill-opacity={group.opacity} />)}
  </svg>
  <svg class="embers-cells" viewBox={`0 0 ${columns} ${rows}`} preserveAspectRatio="xMidYMax meet">
    {lit.map((group) => <path d={group.d} fill={group.fill} fill-opacity={group.opacity} />)}
  </svg>
</div>

<style>
  .embers {
    position: relative;
    pointer-events: none;
  }

  .embers svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .embers-glow {
    filter: blur(28px) saturate(1.2);
    opacity: 0.85;
  }
</style>

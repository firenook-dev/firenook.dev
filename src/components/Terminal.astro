---
// Firenook's own terminal screen, recorded from the published package on a
// demo project (scripts/terminal/). The window opens on the official command
// and waits until the visitor has it in view; then its one word changes and
// the recording plays at its real speed. Without motion, or without
// JavaScript, the last frame shows at once.
import wide from '../data/terminal-wide.json';
import narrow from '../data/terminal-narrow.json';
import { lastScreen, screenHtml, type Recording } from '../lib/terminal';
import { site } from '../lib/site';
import symbols from '../assets/fonts/terminal-symbols.woff2?url';
import Embers from './Embers.astro';
import Pixels from './Pixels.astro';

// The boxes, blocks, ticks and spinner, drawn on Plex Mono's grid by
// scripts/terminal/symbols.py.
const symbolsFace = `@font-face{font-family:"Firenook Terminal Symbols";font-display:block;src:url(${symbols}) format("woff2");unicode-range:U+2500-259F,U+25CF,U+2713,U+2715,U+2800-28FF}`;

const wideHtml = screenHtml(lastScreen(wide as Recording));
const narrowHtml = screenHtml(lastScreen(narrow as Recording));
---

<style is:inline set:html={symbolsFace}></style>
<link rel="preload" href={symbols} as="font" type="font/woff2" crossorigin />
<figure class="term" data-terminal>
  <Embers class="term-embers" />
  <div class="term-window">
    <div class="term-bar" aria-hidden="true">
      <span class="term-title"><Pixels art="flame" size={12} />demo-shop</span>
      <span class="term-meta">recorded from firenook {site.version}</span>
    </div>
    <div class="term-screen">
      <pre class="term-final term-wide" aria-hidden="true" set:html={wideHtml} />
      <pre class="term-final term-narrow" aria-hidden="true" set:html={narrowHtml} />
      <pre class="term-live" aria-hidden="true"><span class="d">$</span> npx <span class="old">firebase</span><span class="new"></span> emulators:start<span class="cursor"></span></pre>
    </div>
  </div>
  <figcaption class="visually-hidden">
    Firenook’s own screen, recorded from {site.version} on a demo project: it starts, takes two orders, and shows a webhook
    that fails, with its stack trace.
  </figcaption>
</figure>

<script>
  import wide from '../data/terminal-wide.json';
  import narrow from '../data/terminal-narrow.json';
  import { rowHtml, type Recording, type Run } from '../lib/terminal';

  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  // Resolves once the visitor is looking: they have started to scroll and half
  // the window (or half of what fits) is on screen, or the whole window was in
  // view as the page opened (true then, so the headline is read first). Only
  // while the tab is in front.
  function seen(target: Element): Promise<boolean> {
    return new Promise((resolve) => {
      const check = () => {
        if (document.visibilityState !== 'visible') return;
        const box = target.getBoundingClientRect();
        const shown = Math.min(box.bottom, innerHeight) - Math.max(box.top, 0);
        const fits = Math.min(box.height, innerHeight);
        const whole = shown >= 0.95 * fits;
        if (!whole && !(scrollY > 0 && shown >= 0.5 * fits)) return;
        removeEventListener('scroll', check);
        removeEventListener('resize', check);
        document.removeEventListener('visibilitychange', check);
        resolve(whole && scrollY === 0);
      };
      addEventListener('scroll', check, { passive: true });
      addEventListener('resize', check);
      document.addEventListener('visibilitychange', check);
      check();
    });
  }

  async function play(figure: HTMLElement) {
    const live = figure.querySelector<HTMLElement>('.term-live');
    const screen = figure.querySelector<HTMLElement>('.term-screen');
    const oldWord = live?.querySelector('.old');
    const newWord = live?.querySelector('.new');
    if (!live || !screen || !oldWord || !newWord) return;
    // The prompt shows, its cursor blinking, until the window is seen.
    figure.classList.add('is-live');
    const atOpen = await seen(figure.querySelector('.term-window') ?? figure);
    const recording = (screen.clientWidth < 600 ? narrow : wide) as Recording;

    await wait(atOpen ? 2200 : 700);
    oldWord.classList.add('is-struck');
    await wait(500);
    for (const letter of 'firenook') {
      newWord.textContent += letter;
      await wait(60);
    }
    await wait(700);

    const rows: Run[][] = Array.from({ length: recording.rows }, () => []);
    const start = performance.now();
    for (const frame of recording.frames) {
      const late = start + frame.t * 1000 - performance.now();
      if (late > 0) await wait(late);
      for (const [y, runs] of frame.d) rows[y] = runs;
      live.innerHTML = rows.map(rowHtml).join('\n');
    }
  }

  if (document.documentElement.classList.contains('motion')) {
    for (const figure of document.querySelectorAll<HTMLElement>('[data-terminal]')) void play(figure);
  }
</script>

<style>
  /* A terminal window the size of its screen, not the page's width. */
  .term {
    position: relative;
    max-width: 58rem;
    margin: 0 auto;
    isolation: isolate;
  }

  /* The fire the screen sits on: light rising behind it, and the embers. */
  .term::before {
    content: '';
    position: absolute;
    inset: 30% -6% -10% -6%;
    z-index: -2;
    background:
      radial-gradient(46% 60% at 32% 100%, rgb(242 56 24 / 0.38), transparent 70%),
      radial-gradient(40% 56% at 68% 100%, rgb(255 152 0 / 0.28), transparent 70%);
    filter: blur(56px);
    pointer-events: none;
  }

  .term :global(.term-embers) {
    position: absolute;
    left: -16%;
    right: -16%;
    bottom: -6.5rem;
    height: 17rem;
    z-index: -1;
    -webkit-mask: linear-gradient(to bottom, transparent, #000 40%, #000 90%, transparent);
    mask: linear-gradient(to bottom, transparent, #000 40%, #000 90%, transparent);
  }

  .term-window {
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.13);
    border-radius: 14px;
    background: var(--cinder);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.07) inset,
      0 0 0 1px rgb(0 0 0 / 0.6),
      0 50px 100px -30px rgb(0 0 0 / 0.9),
      0 30px 80px -40px rgb(242 56 24 / 0.5);
  }

  .term-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 1.1rem;
    border-bottom: 1px solid var(--line);
    background: rgb(255 255 255 / 0.02);
    color: var(--smoke);
    font: 560 var(--text-xs) / 1.2 var(--font);
  }

  .term-title {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .term-meta {
    color: var(--ash);
    font-family: var(--mono);
    font-size: var(--text-xs);
    font-weight: 400;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .term-meta {
      display: none;
    }
  }

  .term-screen {
    position: relative;
    display: grid;
    justify-content: center;
    container-type: inline-size;
    padding: clamp(0.75rem, 2.2vw, 1.75rem) clamp(0.6rem, 2vw, 1.5rem);
  }

  .term pre {
    margin: 0;
    color: #e8e6e1;
    font-family: 'IBM Plex Mono', 'Firenook Terminal Symbols', ui-monospace, Menlo, Consolas, monospace;
    font-size: min(13px, calc(100cqi / 65.2));
    line-height: 1.3;
    white-space: pre;
    tab-size: 8;
  }

  .term-narrow {
    display: none;
  }

  @container (max-width: 600px) {
    .term pre {
      font-size: calc(100cqi / 39.9);
    }

    .term-wide {
      display: none;
    }

    .term-narrow {
      display: block;
    }
  }

  /* The live screen lies over the last frame, in the same place. */
  .term-screen > pre {
    grid-area: 1 / 1;
  }

  .term-live {
    display: none;
  }

  /* With motion, the screen opens on the prompt; the last frame keeps its
     place so nothing below moves while it plays. If the script never runs,
     the last frame shows after a few seconds. */
  :global(html.motion) .term-final {
    visibility: hidden;
    animation: term-fallback 0s 4s forwards;
  }

  :global(html.motion) .term-live {
    display: block;
  }

  :global(html.motion) .term.is-live .term-final {
    visibility: hidden;
    animation: none;
  }

  @keyframes term-fallback {
    to {
      visibility: visible;
    }
  }

  :global(html.motion) .term:not(.is-live) .term-live {
    animation: term-hide 0s 4s forwards;
  }

  @keyframes term-hide {
    to {
      visibility: hidden;
    }
  }

  .term :global(.w) {
    display: inline-block;
  }

  .term :global(.d) {
    color: #8b8990;
  }

  .term :global(.b) {
    font-weight: 600;
  }

  .term :global(.g) {
    color: var(--term-green);
  }

  .term :global(.r) {
    color: var(--term-red);
  }

  .term :global(.u) {
    color: var(--term-blue);
  }

  .term :global(.f) {
    color: var(--flame);
  }

  .term :global(.a) {
    color: var(--amber);
  }

  .term :global(.l) {
    text-decoration: underline;
  }

  .old {
    transition: color 200ms ease;
  }

  .old.is-struck {
    color: #8b8990;
    text-decoration: line-through;
    text-decoration-color: var(--term-red);
    text-decoration-thickness: 2px;
    margin-right: 1ch;
  }

  .new {
    color: var(--term-green);
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 1px;
    vertical-align: text-bottom;
    background: #e8e6e1;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }


</style>

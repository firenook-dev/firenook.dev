---
// The page's title, description, canonical address, link previews and
// structured data.
import { site } from '../lib/site';
import { jsonLd } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** The link preview, from /og; defaults to the page's own. */
  image?: string;
  imageAlt?: string;
  schema?: object;
  noindex?: boolean;
}

const { title, description, image, imageAlt, schema, noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '').replace(/\/$/, '') || '/';
const canonical = path === '/' ? `${site.url}/` : `${site.url}${path}`;
const slug = path === '/' ? 'home' : path.slice(1).replace(/\//g, '-');
const og = new URL(image ?? `/og/${slug}.png`, site.url).href;
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? `${site.name}: ${site.tagline}`} />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />

{schema && <script type="application/ld+json" set:html={jsonLd(schema)} />}

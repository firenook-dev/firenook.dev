---
// Starlight's head, with the site's two faces loaded the way the rest of the
// site loads them.
import Default from '@astrojs/starlight/components/Head.astro';
import figtree from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import plexMono from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import plexMonoBold from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url';

const latin =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fonts = [
  `@font-face{font-family:"Figtree Variable";font-style:normal;font-weight:300 900;font-display:optional;src:url(${figtree}) format("woff2-variations");unicode-range:${latin}}`,
  `@font-face{font-family:"IBM Plex Mono";font-style:normal;font-weight:400;font-display:swap;src:url(${plexMono}) format("woff2")}`,
  `@font-face{font-family:"IBM Plex Mono";font-style:normal;font-weight:600;font-display:swap;src:url(${plexMonoBold}) format("woff2")}`,
].join('');
---

<link rel="preload" href={figtree} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={fonts}></style>
<Default />

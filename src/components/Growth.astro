---
// How many answers had been recorded from Firebase at each release, from the
// recordings in the engine repository at that release's tag
// (src/data/conformance/history.json). A measured bar of whole blocks on one
// scale, as the benchmarks draw theirs: production's part in flame, the
// official emulator's in amber. A preview that recorded fewer than ten new
// answers is left out, so every bar is a step. Upright on a desktop; on a phone each release
// is a row, so nothing scrolls sideways.
import history from '../data/conformance/history.json';
import { formatCount } from '../lib/conformance';

/** What one block of a bar stands for: the same upright and lying down. */
const UNIT = 250;
const releases = history
  .filter((release, index) => {
    const stable = !release.release.includes('-');
    return index === 0 || stable || release.total - history[index - 1].total >= 10;
  })
  .map((release) => {
    const [version, preview] = release.release.split('-');
    // Both parts on the one scale, so production's 1,602 is the same
    // length in every bar.
    const production = release.production > 0 ? Math.max(1, Math.round(release.production / UNIT)) : 0;
    const blocks = Math.max(production + 1, Math.round(release.total / UNIT));
    return {
      ...release,
      version,
      preview: preview ?? null,
      style: `--blocks: ${blocks}; --production-blocks: ${production}`,
    };
  });
---

<figure class="growth">
  <ol class="growth-releases">
    {
      releases.map((release) => (
        <li class:list={['growth-release', { stable: !release.preview }]} style={release.style}>
          <span class="growth-count">{formatCount(release.total)}</span>
          <span class="growth-bar" aria-hidden="true">
            <span class="growth-official" />
            <span class="growth-production" />
          </span>
          <span class="growth-name">
            <span>{release.version}</span>
            <span class="growth-preview">{release.preview ?? ' '}</span>
          </span>
          <span class="visually-hidden">
            {`, ${formatCount(release.production)} from production, released ${release.date}`}
          </span>
        </li>
      ))
    }
  </ol>
  <figcaption class="note">
    Answers recorded at each release, counted from the recordings in the repository at its tag, each bar drawn to one
    scale and production’s part in flame. Previews that added fewer than ten are left out.
  </figcaption>
</figure>

<style>
  .growth {
    margin: 2rem 0 0;
  }

  .growth-releases {
    display: grid;
    grid-auto-flow: column;
    /* Whole-pixel columns from the left edge, so every block lands on a pixel. */
    grid-auto-columns: 6rem;
    justify-content: start;
    gap: 1.5rem;
    align-items: end;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .growth-release {
    display: grid;
    justify-items: center;
    align-items: end;
    gap: 0.45rem;
    min-width: 0;
  }

  .growth-count {
    color: var(--smoke);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .stable .growth-count {
    color: var(--ink);
    font-weight: 600;
  }

  /* Whole 8px blocks with 2px gaps, as on the measured bars: the bar is a
     number of blocks tall, and production's part a number of them. */
  .growth-bar {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 28px;
    height: calc(var(--blocks) * 10px - 2px);
    -webkit-mask:
      repeating-linear-gradient(0deg, #000 0 8px, transparent 8px 10px),
      repeating-linear-gradient(90deg, #000 0 8px, transparent 8px 10px);
    -webkit-mask-composite: source-in;
    mask:
      repeating-linear-gradient(0deg, #000 0 8px, transparent 8px 10px),
      repeating-linear-gradient(90deg, #000 0 8px, transparent 8px 10px);
    mask-composite: intersect;
  }

  .growth-official {
    flex: 1;
    background: #ff9d1c;
  }

  .growth-production {
    flex: none;
    height: calc(var(--production-blocks) * 10px);
    background: #f4421a;
  }

  /* Two lines for every name, so every bar stands on the same line. */
  .growth-name {
    display: grid;
    justify-items: center;
    color: var(--smoke);
    font-size: var(--text-xs);
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }

  .stable .growth-name {
    color: var(--ink);
    font-weight: 600;
  }

  .growth-preview {
    color: var(--ash);
    font-weight: 400;
  }

  /* A phone: the name and count on one line, the bar lying down under them. */
  @media (max-width: 760px) {
    .growth-releases {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.85rem;
    }

    .growth-release {
      grid-template-columns: minmax(0, 1fr) auto;
      justify-items: start;
      align-items: baseline;
      gap: 0.3rem 0.75rem;
    }

    .growth-name {
      grid-column: 1;
      grid-row: 1;
      display: flex;
      gap: 0.3rem;
    }

    .growth-count {
      grid-column: 2;
      grid-row: 1;
    }

    .growth-bar {
      grid-column: 1 / -1;
      grid-row: 2;
      flex-direction: row-reverse;
      width: calc(var(--blocks) * 10px - 2px);
      height: 8px;
      -webkit-mask: repeating-linear-gradient(90deg, #000 0 8px, transparent 8px 10px);
      mask: repeating-linear-gradient(90deg, #000 0 8px, transparent 8px 10px);
    }

    .growth-production {
      height: auto;
      width: calc(var(--production-blocks) * 10px);
    }
  }
</style>
